---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Giscus from '../../../components/Giscus.astro';

const lang = 'zh' as const;
---

<Layout
  title="SoloMD 工作区与组织 — 文件树排序、大纲、搜索、标签、反向链接、Bases 与手机工作区"
  description="用 SoloMD 组织一个 Markdown 笔记文件夹：支持自定义拖拽排序的文件树、大纲跳转、工作区全文与语义搜索、标签、反向链接、Bases 属性表格、日记、收集箱以及 iOS/Android 文件夹授权。"
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/zh/">首页</a> / <a href="/zh/docs/">文档</a> / <span>工作区</span>
      </nav>

      <h1>工作区与组织</h1>
      <p class="lead">打开一次文件夹，文件树、大纲、双向链接、属性表与全局搜索即刻就绪。</p>

      <h2>一、文件树（排序、拖拽、右键快捷操作）</h2>
      <ul>
        <li><strong>显示与隐藏</strong>：按 <kbd>Ctrl/⌘ + B</kbd>（或点击窗口顶栏左侧的侧栏收起图标）切换文件树显示。</li>
        <li><strong>四种文件排序方式</strong>：支持按<strong>名称</strong>、<strong>创建时间</strong>、<strong>修改时间</strong>排序，或直接<strong>鼠标拖拽文件排出你自己的自定义顺序</strong>（新建文件自动排在末尾）。</li>
        <li><strong>就地管理与快捷键</strong>：在目标文件夹内就地输入名称新建笔记（<kbd>Ctrl/⌘ + Alt + Shift + N</kbd>）或子文件夹；按 <kbd>F2</kbd> 重命名，<kbd>Del</kbd> 删除（进入系统回收站，删除前弹窗确认）；支持右键<strong>「一键展开 / 折叠全部子目录」</strong>与<strong>「复制相对路径」</strong>。</li>
        <li><strong>贴心显示细节</strong>：已打开的文件旁显示圆点指示；可选开启<strong>「显示文件夹内文件数量角标」</strong>、<strong>「双击打开文件」</strong>；存放图片的附件目录（<code>_assets</code>、<code>*.assets</code>）默认自动隐藏保持清爽（开启「显示隐藏文件」后可见）；切换标签页时文件树自动定位并高亮当前文件（可在设置中关闭）。</li>
      </ul>

      <h2>二、大纲与快速跳转</h2>
      <ul>
        <li><kbd>Ctrl/⌘ + Shift + O</kbd> 显示 / 隐藏大纲面板。点击标题精准跳转（在分栏与预览下均精准对齐标题并跟随阅读位置高亮）；章节可折叠。</li>
        <li><strong>键盘跳转标记</strong>：按标题旁显示的字母即可用键盘瞬间跳转；按 <code>g</code> + 行号跳到指定行。标记样式（字母 / 数字 / 无）及大纲停靠在左侧或右侧均可配置。</li>
      </ul>

      <h2>三、右侧栏多功能面板</h2>
      <p>
        右键侧栏（或用命令面板）开关各个面板；拖拽调整顺序和大小。<kbd>Ctrl/⌘ + Alt + B</kbd> 隐藏整条右侧栏。
      </p>
      <table class="kb-table">
        <thead><tr><th>面板</th><th>显示内容</th></tr></thead>
        <tbody>
          <tr><th>搜索 (<kbd>Ctrl/⌘+Shift+F</kbd>)</th><td>工作区文件夹的 ripgrep 级极速全文搜索（支持大小写、全词、正则表达式）。</td></tr>
          <tr><th>反向链接</th><td>所有通过 <code>[[笔记]]</code>、<code>[[文件夹/笔记]]</code> 或 <code>[[笔记.md]]</code> 链接到当前笔记的笔记（自动忽略代码块内的示例）。</td></tr>
          <tr><th>关系与邻域图谱</th><td>解析 front-matter 中的类型化关系（如 <code>depends_on</code>、<code>part_of</code>）并提供以当前笔记为中心的交互式关系网络图。</td></tr>
          <tr><th>标签</th><td>汇总工作区里的全部 <code>#标签</code>（支持中文标签，自动过滤表格与代码中的十六进制颜色码 <code>#fff</code>）。</td></tr>
          <tr><th>历史</th><td>当前笔记的本地 Git 快照时间线，支持一键对比差异与回滚（见 <a href="/zh/docs/sync/">同步与历史</a>）。</td></tr>
          <tr><th>属性</th><td>YAML front-matter 可视化表单编辑器。</td></tr>
          <tr><th>智能体 (Agent)</th><td>与你的整个笔记仓库多轮对话、检索或生成内容（见 <a href="/zh/docs/ai/">AI 功能</a>）。</td></tr>
        </tbody>
      </table>

      <h2>四、Bases 属性表格与保存的视图</h2>
      <ul>
        <li><strong>Bases（把笔记库当数据库表格看）</strong>：命令面板 →「工作区：属性表格 (Bases)」，将每篇笔记作为一行，展示在一张由 front-matter 属性构成、可排序可筛选可原地编辑的表格里。</li>
        <li><strong>保存的视图 (Saved Views)</strong>：按标签、类型、属性或文件夹保存持久化筛选视图（存放在 <code>.solomd/views/*.yml</code>），固定显示在左侧文件树下方。</li>
      </ul>

      <h2>五、日记、快速记录与收集箱</h2>
      <ul>
        <li><strong>每日笔记（<kbd>Ctrl/⌘ + D</kbd>）</strong>：一键打开或按模板创建今天的日记，昨天/明天日记一键直达。</li>
        <li><strong>快速记录（<kbd>Ctrl/⌘ + Alt + Shift + M</kbd>）与收集箱</strong>：随时呼出轻量记录窗，连同浏览器扩展 Web Clipper 剪藏的网页一起汇入收集箱，通过「标记已整理并前进」逐条归档。</li>
      </ul>

      <h2>六、iPhone / iPad 与 Android 移动工作区</h2>
      <ul>
        <li><strong>iPhone 与 iPad</strong>：可将系统「文件」App 中的任意文件夹（iCloud 云盘、我的 iPhone 或第三方同步盘）选为工作区并跨重启持久记忆；从「文件」App 打开的单篇笔记直接原地编辑保存；触屏长按文件树项或点击 <code>⋯</code> 即可重命名、移动、删除。</li>
        <li><strong>Android</strong>：完整支持在 SAF 授权工作区目录内直接新建子文件夹、创建日记、粘贴保存图片到 <code>_assets/</code>，并在切回应用时自动刷新 Syncthing 等外部同步工具的修改。</li>
      </ul>

      <Giscus />
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
