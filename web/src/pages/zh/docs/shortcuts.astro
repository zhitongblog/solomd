---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Giscus from '../../../components/Giscus.astro';

const lang = 'zh' as const;

type Row = [string, string, string];
const file: Row[] = [
  ['新建 Markdown 笔记', 'Ctrl + N', '⌘ N'],
  ['在当前选中文件夹新建笔记', 'Ctrl + Alt + Shift + N', '⌘ ⌥ ⇧ N'],
  ['新建纯文本文件', 'Ctrl + Alt + N', '⌘ ⌥ N'],
  ['打开文件', 'Ctrl + O', '⌘ O'],
  ['保存', 'Ctrl + S', '⌘ S'],
  ['另存为…', 'Ctrl + Shift + S', '⌘ ⇧ S'],
  ['打印（系统打印对话框）', 'Ctrl + P', '⌘ P'],
  ['关闭当前标签页', 'Ctrl + W', '⌘ W'],
  ['恢复刚关闭的标签页', 'Ctrl + Shift + T', '⌘ ⇧ T'],
  ['新建窗口', 'Ctrl + Shift + N', '⌘ ⇧ N'],
];
const view: Row[] = [
  ['按最近使用顺序切换标签页 (MRU)', 'Ctrl + Tab / Ctrl + Shift + Tab', 'Ctrl + Tab / Ctrl + Shift + Tab'],
  ['按标签栏左右顺序切换标签页', 'Ctrl + PageUp / PageDown', '⌘ ⇧ [ / ⌘ ⇧ ]'],
  ['显示 / 隐藏文件树（默认预设）', 'Ctrl + B', '⌘ B'],
  ['显示 / 隐藏大纲', 'Ctrl + Shift + O', '⌘ ⇧ O'],
  ['显示 / 隐藏右侧栏', 'Ctrl + Alt + B', '⌘ ⌥ B'],
  ['循环切换视图（实时 / 源码 / 分栏 / 预览）', 'Ctrl + Shift + P', '⌘ ⇧ P'],
  ['在「实时编辑」与「纯源码」间快速切换', 'Ctrl + Alt + /', '⌘ ⌥ /'],
  ['切换「预览模式」', 'Ctrl + Alt + V', '⌘ ⌥ V'],
  ['向右拆分编辑窗格', 'Ctrl + \\', '⌘ \\'],
  ['专注模式（仅高亮当前段落）', 'F8', 'F8'],
  ['打字机模式（光标行始终居中）', 'F9', 'F9'],
  ['整体缩放界面（带百分比提示）', 'Ctrl + + / - / 0', '⌘ + / - / 0'],
  ['打开命令面板（支持模糊搜索所有功能）', 'Ctrl + Shift + K', '⌘ ⇧ K'],
  ['打开设置', 'Ctrl + ,', '⌘ ,'],
  ['查看快捷键速查与 Markdown 语法帮助', 'F1', 'F1 或 ⌘ /'],
];
const formatting: Row[] = [
  ['加粗（可在设置切换为 Ctrl/⌘+B 写作预设）', 'Ctrl + Shift + B（或 Ctrl + B）', '⌘ ⇧ B（或 ⌘ B）'],
  ['斜体', 'Ctrl + I', '⌘ I'],
  ['删除线', 'Ctrl + Shift + X', '⌘ ⇧ X'],
  ['高亮 (==文字==)', 'Ctrl + Shift + H', '⌘ ⇧ H'],
  ['行内代码 (`code`)', 'Ctrl + E', '⌘ E'],
  ['插入链接', 'Ctrl + K', '⌘ K'],
  ['插入代码块 (```)', 'Ctrl + Shift + C', '⌘ ⇧ C'],
  ['一至六级标题 (H1–H6)', 'Ctrl + 1 … 6', '⌘ 1 … 6'],
  ['提升 / 降低标题级别', 'Ctrl + = / Ctrl + -', '⌘ = / ⌘ -'],
  ['转为普通段落', 'Ctrl + 0', '⌘ 0'],
  ['引用块 (> )', 'Ctrl + Shift + Q', '⌘ ⇧ Q'],
  ['无序列表 / 有序列表 / 任务列表', 'Ctrl + Shift + U / O / L', '⌘ ⇧ U / O / L'],
  ['折叠 / 展开当前章节或代码块', 'Ctrl + Shift + [ / ]（可改绑）', '⌘ ⌥ [ / ]（可改绑）'],
];
const editing: Row[] = [
  ['撤销 / 重做', 'Ctrl + Z / Ctrl + Y', '⌘ Z / ⌘ ⇧ Z'],
  ['全选（在代码块内按第 1 次选代码块，第 2 次选全文）', 'Ctrl + A', '⌘ A'],
  ['列表项内软换行（保持列表缩进，可用于插入缩进代码块）', 'Shift + Enter', 'Shift + Enter'],
  ['笔记内查找（再按一次关闭查找栏）', 'Ctrl + F', '⌘ F'],
  ['查找与替换', 'Ctrl + H', '⌘ ⌥ F'],
  ['工作区全局搜索', 'Ctrl + Shift + F', '⌘ ⇧ F'],
  ['打开今日日记', 'Ctrl + D', '⌘ D'],
  ['快速记录弹窗 (Quick Capture)', 'Ctrl + Alt + Shift + M', '⌘ ⌥ ⇧ M'],
  ['打开公式编辑器', 'Ctrl + Alt + M', '⌘ ⌥ M'],
  ['AI 改写选中文本', 'Ctrl + J', '⌘ J'],
];
---

<Layout
  title="SoloMD 键盘快捷键大全 — 完整参考与自定义指南"
  description="SoloMD 在 Windows、macOS 与 Linux 上的全部键盘快捷键：文件操作、视图切换、Typora/Word 写作预设、Markdown 格式化、代码块两段式全选与鼠标快捷操作。"
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/zh/">首页</a> / <a href="/zh/docs/">文档</a> / <span>键盘快捷键</span>
      </nav>

      <h1>键盘快捷键</h1>
      <p class="lead">
        SoloMD 的每一个快捷键都可以在 <strong>设置 → 快捷键</strong> 中自由修改，也可以按 <kbd>F1</kbd> 随时搜索当前生效的按键。
      </p>

      <h2>习惯用 Ctrl/⌘ + B 加粗？（写作快捷键预设）</h2>
      <p>
        SoloMD 默认将 <kbd>Ctrl/⌘ + B</kbd> 用于开关左侧文件树，加粗放在 <kbd>Ctrl/⌘ + Shift + B</kbd>。
        如果你习惯了 Typora 或 Word 的按键方式，打开 <strong>设置 → 快捷键</strong>，点击顶部的
        <strong>「Typora / Word 写作预设」</strong> 即可一键把 <kbd>Ctrl/⌘ + B</kbd> 切换为加粗（再次点击可随时恢复）。
      </p>

      <h2>文件操作</h2>
      <table class="kb-table">
        <thead><tr><th>功能</th><th>Windows / Linux</th><th>macOS</th></tr></thead>
        <tbody>{file.map((r) => <tr><th>{r[0]}</th><td><code>{r[1]}</code></td><td><code>{r[2]}</code></td></tr>)}</tbody>
      </table>

      <h2>视图、标签页与导航</h2>
      <table class="kb-table">
        <thead><tr><th>功能</th><th>Windows / Linux</th><th>macOS</th></tr></thead>
        <tbody>{view.map((r) => <tr><th>{r[0]}</th><td><code>{r[1]}</code></td><td><code>{r[2]}</code></td></tr>)}</tbody>
      </table>

      <h2>Markdown 排版与章节折叠</h2>
      <p>
        所有排版快捷键都是<strong>开关式</strong>的：选中文本按一次添加格式，再按一次取消格式；未选中文本时自动作用于光标所在的词语。
        选中多行无序列表或相连的多行文本按「有序列表」快捷键时，会整组转换为 <code>1. 2. 3.</code> 有序列表。
      </p>
      <table class="kb-table">
        <thead><tr><th>功能</th><th>Windows / Linux</th><th>macOS</th></tr></thead>
        <tbody>{formatting.map((r) => <tr><th>{r[0]}</th><td><code>{r[1]}</code></td><td><code>{r[2]}</code></td></tr>)}</tbody>
      </table>

      <h2>编辑、查找与效率工具</h2>
      <table class="kb-table">
        <thead><tr><th>功能</th><th>Windows / Linux</th><th>macOS</th></tr></thead>
        <tbody>{editing.map((r) => <tr><th>{r[0]}</th><td><code>{r[1]}</code></td><td><code>{r[2]}</code></td></tr>)}</tbody>
      </table>

      <h2>鼠标高效操作技巧</h2>
      <ul>
        <li><strong><kbd>Ctrl/⌘</kbd> + 左键单击链接</strong>：直接在系统默认浏览器中打开该超链接；普通左键单击则是把光标放进链接文字内进行编辑。</li>
        <li><strong>双击中文词语</strong>：内置 <code>Intl.Segmenter</code> 中文分词，双击汉字精准选中当前词语而非整句。</li>
        <li><strong>三击鼠标左键</strong>：精准选中当前整行文本，且<strong>不会附带行尾换行符</strong>，复制粘贴到别处时不会多出空行。</li>
        <li><strong>实时模式点击表格单元格</strong>：直接把光标落位到你点击的那一行、那一列单元格内部，方便直接修改数据。</li>
      </ul>

      <h2>Vim 模式</h2>
      <p>
        在 <strong>设置 → 编辑器 → Vim 模式</strong> 中开启。支持标准 Normal / Insert / Visual 模式、动作指令（<code>h j k l w b e</code>）及操作符（<code>d y c</code>），Leader 键为 <code>\</code>。
      </p>
    </article>
    <Giscus lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .docs-article { max-width: 820px; padding: 40px 20px 80px; }
  .breadcrumbs { font-size: 13px; color: var(--text-muted, #8a8a8a); margin-bottom: 16px; }
  .breadcrumbs a { color: inherit; }
  .docs-article h1 { font-size: 2rem; margin: 10px 0 16px; }
  .docs-article h2 { font-size: 1.4rem; margin: 32px 0 12px; }
  .docs-article .lead { color: var(--text-muted, #555); margin-bottom: 24px; line-height: 1.6; }
  .kb-table { width: 100%; border-collapse: collapse; margin: 14px 0 20px; font-size: 14px; }
  .kb-table th, .kb-table td { text-align: left; padding: 9px 12px; border-bottom: 1px solid #eee; }
  .kb-table thead th { background: #fafafa; font-weight: 600; }
  .kb-table tbody th { font-weight: 500; width: 44%; }
  .docs-article code { background: #f5f5f0; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  .docs-article p, .docs-article li { line-height: 1.7; margin: 10px 0; }
</style>
