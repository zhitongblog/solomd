---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Giscus from '../../../components/Giscus.astro';

const lang = 'zh' as const;
---

<Layout
  title="SoloMD 编辑器 — 实时渲染、图片、表格、Vim、打字机模式"
  description="SoloMD 编辑器工作原理:实时所见即所得渲染、图片粘贴与上传、表格编辑、数学公式、Mermaid、PlantUML、白板、专注与打字机模式、Vim 按键,以及 Windows 上对输入法安全的编辑器。"
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/zh/">首页</a> / <a href="/zh/docs/">文档</a> / <span>编辑器</span>
      </nav>

      <h1>编辑器</h1>
      <p class="lead">你和文字之间的一切。</p>

      <h2>实时编辑：在书写处直接渲染</h2>
      <p>
        在实时编辑模式下，格式就地渲染，光标所在行会显示原始 Markdown 供你编辑 ——
        光标移开后又恢复渲染。粗体 / 斜体 / 删除线、<code>==高亮==</code>、链接、
        标题、引用、任务列表都是如此，整块内容也一样：
      </p>
      <ul>
        <li><strong>表格</strong>渲染为真正的表格（AI 导出中格式不规范的分隔行会被自动修复）。</li>
        <li><strong>数学公式</strong> —— 行内 <code>$…$</code> 与块级 <code>$$…$$</code>，由 KaTeX 渲染。</li>
        <li><strong>Mermaid</strong> 与 <strong>PlantUML</strong> 代码块渲染为图表（PlantUML 需手动开启 —— 它会把图表源码发送到你配置的服务器）。</li>
        <li><strong>图片</strong> —— 独占一行的 <code>![alt](path)</code> 直接显示图片。</li>
        <li><strong>内嵌 HTML</strong> —— 块级容器（<code>&lt;div&gt;</code>、<code>&lt;table&gt;</code>、<code>&lt;details&gt;</code>…）与行内标签（<code>&lt;strong&gt;</code>、<code>&lt;sup&gt;</code>、<code>&lt;kbd&gt;</code>…）渲染效果与预览一致。</li>
        <li><strong>GitHub 风格提示块</strong> —— <code>&gt; [!NOTE]</code> / TIP / IMPORTANT / WARNING / CAUTION。</li>
        <li><strong>白板</strong> —— <code>```tldraw</code> 代码块嵌入一块可实时绘制的画布，内容保存回笔记本身。</li>
      </ul>

      <h2>图片</h2>
      <ul>
        <li><strong>粘贴截图</strong> —— 自动保存到笔记旁边（或 front-matter 里 <code>imageRoot</code> / 附件设置指定的文件夹），并自动插入链接。</li>
        <li><strong>拖放</strong>图片文件到编辑器即可插入。</li>
        <li><strong>图床</strong> —— 可选择把本地图片上传到 PicGo、SM.MS、S3 或 GitHub，在命令面板执行“上传本地图片到图床…”。</li>
      </ul>

      <h2>写作助手</h2>
      <table class="kb-table">
        <thead><tr><th>功能</th><th>用法</th></tr></thead>
        <tbody>
          <tr><th>斜杠命令</th><td>在空行输入 <code>/</code> 唤出块模板 —— 表格、代码块、公式、提示块……</td></tr>
          <tr><th>Wiki 链接</th><td><code>[[笔记名]]</code>，带自动补全；点击跳转，同时驱动反向链接和关系图。</td></tr>
          <tr><th>标签</th><td><code>#标签</code>，带自动补全；在标签面板里浏览。</td></tr>
          <tr><th>查找 / 替换</th><td>笔记内按 <kbd>Ctrl/⌘ F</kbd>；输入的同时结果就滚动到可见位置。</td></tr>
          <tr><th>AI 改写</th><td>选中文字 → <kbd>Ctrl/⌘ J</kbd>。见 <a href="/zh/docs/ai/">AI 功能</a>。</td></tr>
          <tr><th>格式化文档</th><td>命令面板 → “格式化 Markdown (Prettier)”。</td></tr>
          <tr><th>清理 AI 痕迹</th><td>命令面板 → 规范化弯引号、长破折号和不可见字符。</td></tr>
        </tbody>
      </table>

      <h2>专注写作的模式</h2>
      <ul>
        <li><strong>专注模式</strong>把当前段落之外的内容全部调暗。</li>
        <li><strong>打字机模式</strong>让光标所在行始终垂直居中。</li>
        <li><strong>Vim 模式</strong>（设置 → 编辑器）—— 模态编辑，包括用 <code>j/k</code> 在渲染块上移动。</li>
        <li><strong>缩放</strong> —— <kbd>Ctrl/⌘ +</kbd>/<kbd>−</kbd>/<kbd>0</kbd> 缩放整个应用（走系统 WebView 缩放，所以点击位置始终精确）；编辑器字号与预览字号另有独立设置。</li>
      </ul>

      <h2>外观</h2>
      <ul>
        <li>浅色 / 深色主题切换；自定义 CSS 文件可以完全换肤（设置 → 外观）。</li>
        <li>编辑器字体、<strong>独立的代码字体</strong>、字号、行号、自动换行、编辑器栏宽限制。</li>
        <li>设置中提供<strong>光标不闪烁</strong>选项。</li>
      </ul>

      <h2>关于 Windows 与中日韩输入法</h2>
      <p>
        在 Windows 上，SoloMD 使用一条专门打造的纯文本编辑器路径，绕开 WebView2
        长期存在的输入法 bug（首字符丢失、标点重复）。代价是：源码模式下的语法高亮
        受限；实时编辑、分栏和预览则完整渲染。在 Windows 上开启 Vim 模式会切换回
        CodeMirror 编辑器。
      </p>

      <Giscus />
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
