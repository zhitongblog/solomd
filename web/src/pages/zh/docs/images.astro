---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Giscus from '../../../components/Giscus.astro';

const lang = 'zh' as const;
---

<Layout
  title="图片、缩放与图床 — 粘贴截图保存位置、默认宽度预设、防盗链与图床上传"
  description="SoloMD 如何保存与渲染图片：默认的 _assets 目录、每篇笔记独立目录、兼容 Typora 的自定义路径模板、粘贴图片默认宽度预设与右键缩放、PicGo/S3/GitHub 图床以及防盗链外链渲染。"
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/zh/">首页</a> / <a href="/zh/docs/">文档</a> / <span>图片与附件</span>
      </nav>

      <h1>图片、缩放与图床</h1>
      <p class="lead">粘贴的截图落在哪里、怎么控制图片显示大小，以及如何接入图床或加载防盗链外链图片。</p>

      <h2>一、粘贴截图时发生了什么</h2>
      <p>
        截图到剪贴板，把光标放进笔记，按 <kbd>Ctrl/⌘ + V</kbd>（或把图片拖进窗口）—— SoloMD 会把图片文件写到笔记旁边的磁盘上，并自动插入 Markdown 相对路径链接（即使文件夹路径含空格或 Windows 反斜杠也能自动编码与正常显示）：
      </p>
      <pre><code>我的文件夹/
├── 笔记.md          ← 在这里粘贴
└── _assets/
    └── image-20261102-093012.png</code></pre>

      <h2>二、三种附件保存目录模式</h2>
      <p>打开 <strong>设置 → 写作</strong>，在「粘贴 / 拖入图片的保存位置」中任选其一：</p>
      <table class="kb-table">
        <thead><tr><th>模式</th><th>图片存到哪里</th><th>适用场景</th></tr></thead>
        <tbody>
          <tr>
            <th>共享目录（默认）</th>
            <td>每个目录下共用一个文件夹 —— 默认为 <code>_assets/</code>，也可在下方输入框改名为 <code>images</code> 或任意名称。</td>
            <td>清爽简洁；文件树默认自动隐藏 <code>_assets</code> 避免干扰。</td>
          </tr>
          <tr>
            <th>每篇笔记独立</th>
            <td>每篇笔记旁的 <code>&lt;笔记名&gt;.assets/</code>（如 <code>周报.md</code> 对应 <code>周报.assets/</code>）。</td>
            <td>单篇笔记自包含；在 SoloMD 文件树中重命名笔记时，对应的 <code>.assets/</code> 文件夹与正文图片链接会自动同步改名。</td>
          </tr>
          <tr>
            <th>自定义路径（兼容 Typora）</th>
            <td>支持变量 <code>$&#123;filename&#125;</code> 的路径模板，如 <code>./images/$&#123;filename&#125;/</code> 或 <code>../attachments/</code>。</td>
            <td>从 Typora 迁移过来的既有笔记库，直接沿用原路径规则。</td>
          </tr>
        </tbody>
      </table>

      <h2>三、粘贴图片默认宽度预设与右键缩放</h2>
      <ul>
        <li><strong>默认宽度预设</strong>：如果觉得高分屏截图粘贴进来太大，可在 <strong>设置 → 写作 → 粘贴图片默认宽度</strong> 中设置预设比例（如 <code>50%</code>、<code>67%</code>、<code>80%</code> 或指定像素宽度），之后粘贴的图片会自动按该宽度生成。</li>
        <li><strong>右键快速缩放与复制图片</strong>：在编辑器中右键点击任意图片，即可一键切换缩放比例（25% / 50% / 67% / 80% / 100%）或点击「复制图片」写回系统剪贴板。</li>
        <li><strong>同行并排多张图片</strong>：同一行内连续放置多张 <code>&lt;img&gt;</code> 标签时，实时编辑与预览均支持横向并排展示。</li>
      </ul>

      <h2>四、图床自动上传（PicGo / SM.MS / S3 / R2 / GitHub）</h2>
      <p>
        如果你希望写博客时图片直接变成公网链接，可在 <strong>设置 → 图片上传（图床）</strong> 中配置：
      </p>
      <ul>
        <li><strong>PicGo</strong>（对接本地运行的 PicGo App / PicGo-Core）、<strong>SM.MS</strong>、<strong>Amazon S3 / Cloudflare R2 / 阿里云 OSS / 腾讯云 COS 兼容存储</strong>、<strong>GitHub 仓库图床</strong>。</li>
        <li>开启「粘贴时自动上传」后，截图按 <kbd>Ctrl/⌘ + V</kbd> 即自动上传并插入远端 URL；也可以平时存本地，发布前在命令面板执行<strong>「上传当前文档中的本地图片到图床」</strong>一键批量替换。</li>
      </ul>

      <h2>五、网络图片防盗链与移动端本地图片</h2>
      <ul>
        <li><strong>防盗链外链直接显示</strong>：SoloMD 在实时编辑与预览中为所有图片启用了 <code>referrerpolicy="no-referrer"</code>，并兼容含 <code>&amp;amp;</code> 签名参数的 URL，因此 Gitee 仓库外链、百度文心/BOS 签名图片及各类防盗链图床均可直接显示，不会报 403。</li>
        <li><strong>Android 与 iOS 原生支持</strong>：Android 端支持通过相册选图插入 SAF 工作区 <code>_assets/</code> 目录，并原生解析 <code>./pic/a.png</code>、<code>../assets/b.jpg</code> 等相对路径图片，导出 PDF / Word 时同样完整内联。</li>
      </ul>

      <Giscus />
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
