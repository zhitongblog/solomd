---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import V5Showcase from '../../components/V5Showcase.astro';
import FactPack from '../../components/FactPack.astro';
import BuiltByClaude from '../../components/BuiltByClaude.astro';
import UseCases from '../../components/UseCases.astro';
import Principles from '../../components/Principles.astro';
import Features from '../../components/Features.astro';
import Compare from '../../components/Compare.astro';
import Download from '../../components/Download.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Sponsor from '../../components/Sponsor.astro';
import Footer from '../../components/Footer.astro';

const lang = 'zh' as const;
---

<Layout
  title="SoloMD — 不止于 Typora 的安静手感 · 五端免费加密同步与本地 AI 的开源 Markdown 知识库"
  description="兼具 Typora 的纯正所见即所得写作手感与 Obsidian 的本地双链知识库：内置 9 格式直出导出（无需配置 Pandoc）、按知识库隔离的五端加密同步（Mac / Win / Linux / iOS / Android）、本地离线语义搜索、OPR 零配置本地模型 + 20+ 家 BYOK AI 与 16 工具 MCP 服务。约 14–30 MB，MIT 开源，永久免费。"
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <FactPack lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
