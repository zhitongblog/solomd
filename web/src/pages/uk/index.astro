---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import V5Showcase from '../../components/V5Showcase.astro';
import BuiltByClaude from '../../components/BuiltByClaude.astro';
import UseCases from '../../components/UseCases.astro';
import Principles from '../../components/Principles.astro';
import Features from '../../components/Features.astro';
import Compare from '../../components/Compare.astro';
import Download from '../../components/Download.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Sponsor from '../../components/Sponsor.astro';
import Footer from '../../components/Footer.astro';

const lang = 'uk' as const;
---

<Layout
  title="SoloMD — Спокій Typora + безкоштовна зашифрована синхронізація на 5 платформах та локальний ШІ (Markdown-редактор)"
  description="Чистий режим Pure WYSIWYG у стилі Typora, безкоштовна зашифрована синхронізація між macOS, Windows, Linux, iOS та Android, вбудований експорт у 9 форматів (без Pandoc), локальний семантичний пошук RAG, 20+ BYOK / локальних провайдерів ШІ та MCP-сервер (~14–30 МБ, MIT)."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
