---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Giscus from '../../components/Giscus.astro';
import CompareFaq from '../../components/CompareFaq.astro';

const lang = 'en' as const;
const FAQ = [
  {
    q: 'Which export formats are built in, and which need Pandoc?',
    a: 'HTML, PDF (vector text and image), DOCX, and PNG export are built in with zero external dependencies across desktop and mobile (Android & iOS). EPUB, ODT, LaTeX, and RTF go through Pandoc if installed on your PATH.',
  },
  {
    q: 'Do math equations, highlights, callouts, and diagrams survive DOCX export?',
    a: 'Yes — SoloMD generates a true .docx file where KaTeX math becomes native editable Word equations (MathML), Mermaid and PlantUML diagrams are embedded as crisp images, and ==highlights==, sub/superscripts, callouts, task checkboxes (☐/☑), footnotes, and separate ordered list numbering runs are all preserved.',
  },
  {
    q: 'How do I paste styled content with equations into Microsoft Word, WPS, Notion, or WeChat?',
    a: 'For Word, WPS, or Pages, use Edit (or right-click) → “Copy as Word”, which promotes clean MathML equations and hanging-indent lists for Word. For WeChat 公众号, Notion, Confluence, or Slack, use “Copy as Rich HTML”.',
  },
  {
    q: 'Why does pasting from Excel or WPS produce a Markdown table instead of a screenshot?',
    a: 'SoloMD inspects clipboard HTML <table> and TSV data first (including multi-line cells and colspan) and converts spreadsheet ranges directly into aligned Markdown tables rather than pasting the fallback bitmap image.',
  },
];
---

<Layout
  title="Export & Copy in SoloMD — PDF, DOCX, HTML, Print, Copy as Word & Excel Paste"
  description="How SoloMD exports Markdown to vector PDF, native Word (.docx), standalone HTML, and PNG, plus Copy as Word, Rich HTML copy, and pasting Excel/WPS tables into Markdown."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <article class="container docs-article">
      <nav class="breadcrumbs">
        <a href="/">Home</a> / <a href="/docs/">Docs</a> / <span>Export &amp; Copy</span>
      </nav>

      <h1>Export &amp; Copy</h1>
      <p class="lead">Get your Markdown out to PDF, Word, standalone HTML, or the clipboard — and bring tables and lists in from Excel or Word.</p>

      <h2>Export menu (Toolbar → Export or File → Export)</h2>
      <table class="kb-table">
        <thead><tr><th>Format</th><th>Best for</th><th>Highlights</th></tr></thead>
        <tbody>
          <tr>
            <th>PDF (Text)</th>
            <td>Formal reports, searchable &amp; selectable PDFs</td>
            <td>Native vector text and math rendering across macOS, Windows, Linux, Android, and iOS. Repeats table headers across pages, supports an optional <strong>table-of-contents page with page numbers</strong> (Settings → PDF), and inlines your active custom theme and <code>custom.css</code>.</td>
          </tr>
          <tr>
            <th>PDF (Image)</th>
            <td>Pixel-identical layout to the preview</td>
            <td>Avoids slicing through lines of text or table rows at page breaks, and embeds web images and diagrams reliably.</td>
          </tr>
          <tr>
            <th>Word (.docx)</th>
            <td>Office collaboration &amp; formal submissions</td>
            <td>True <code>.docx</code> structure: native Word math equations, <code>==highlight==</code>, underline, sub/superscripts, <code>&lt;kbd&gt;</code>, callouts, footnotes, embedded local/web images, Mermaid/PlantUML diagrams, and independent ordered-list numbering per section.</td>
          </tr>
          <tr>
            <th>Standalone HTML</th>
            <td>Offline sharing &amp; single-file archives</td>
            <td>Truly self-contained: local images are embedded, Mermaid diagrams are embedded as inline SVG, and KaTeX math styles/fonts plus your custom theme CSS are inlined so it opens offline instantly.</td>
          </tr>
          <tr>
            <th>Image (PNG)</th>
            <td>Social sharing &amp; long screenshots</td>
            <td>Captures the full rendered document as a single high-DPI PNG.</td>
          </tr>
        </tbody>
      </table>

      <h2>Copy to clipboard (Edit menu or right-click menu)</h2>
      <table class="kb-table">
        <thead><tr><th>Action</th><th>Best for</th></tr></thead>
        <tbody>
          <tr>
            <th>Copy as Word</th>
            <td>Pasting straight into <strong>Microsoft Word, WPS Office, or Apple Pages</strong> with native MathML equations, clean code blocks, and proper hanging-indent lists.</td>
          </tr>
          <tr>
            <th>Copy as Rich HTML</th>
            <td>Pasting into <strong>WeChat 公众号, Notion, Confluence, Feishu, or Slack</strong> while keeping theme styling.</td>
          </tr>
          <tr>
            <th>Code block copy</th>
            <td>Clicking Copy, dragging to select, or pressing <kbd>Ctrl/⌘ A</kbd> inside an indented code block automatically strips the fence’s leading alignment spaces (and normalizes to <code>CRLF</code> on Windows for legacy Win32 apps).</td>
          </tr>
        </tbody>
      </table>

      <h2>Pasting &amp; importing from Excel, WPS, and Word</h2>
      <ul>
        <li><strong>Excel / WPS spreadsheet cells → Markdown table</strong>: copy any multi-cell range in Excel, WPS, Numbers, or a web table and press <kbd>Ctrl/⌘ V</kbd> in SoloMD to insert a formatted Markdown table instead of a bitmap image.</li>
        <li><strong>Word multi-level lists → Markdown lists</strong>: pasting numbered or bulleted lists from Word or WPS converts them cleanly into Markdown list syntax.</li>
        <li><strong>Open .docx / .html files directly</strong>: opening a Word or HTML document from File → Open or the file tree imports it as clean Markdown.</li>
      </ul>

      <h2>Dedicated Print (<kbd>Ctrl/⌘ + P</kbd>)</h2>
      <p>
        Opens the native system print dialog across all platforms, separate from “Export as PDF”. Only the clean rendered document is sent to the printer.
      </p>

      <h2>CJK and legacy encodings</h2>
      <p>
        SoloMD auto-detects UTF-8, UTF-16 (LE/BE), GBK / GB18030, Big5, Shift-JIS, and EUC-KR when reading files, and saves back in the source file’s original encoding by default.
      </p>

      <CompareFaq heading="Frequently asked questions" items={FAQ} />
    </article>
    <Giscus lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .docs-article { max-width: 820px; padding: 40px 20px 80px; }
  .breadcrumbs { font-size: 13px; color: var(--text-muted, #8a8a8a); margin-bottom: 16px; }
  .breadcrumbs a { color: inherit; }
  .docs-article h1 { font-size: 2rem; margin: 10px 0 16px; }
  .docs-article h2 { font-size: 1.4rem; margin: 32px 0 12px; }
  .docs-article .lead { color: var(--text-muted, #555); margin-bottom: 24px; line-height: 1.6; font-size: 1.05rem; }
  .kb-table { width: 100%; border-collapse: collapse; margin: 14px 0 20px; font-size: 14px; }
  .kb-table th, .kb-table td { text-align: left; padding: 9px 12px; border-bottom: 1px solid #eee; }
  .kb-table thead th { background: #fafafa; font-weight: 600; }
  .kb-table tbody th { font-weight: 500; width: 24%; }
  .docs-article code { background: #f5f5f0; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  .docs-article pre { background: #f5f5f0; padding: 12px 16px; border-radius: 6px; overflow-x: auto; }
  .docs-article pre code { background: none; padding: 0; }
  .docs-article p, .docs-article li { line-height: 1.7; margin: 10px 0; }
</style>
