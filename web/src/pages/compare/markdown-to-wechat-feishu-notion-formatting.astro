const lang = 'en' as const;
const FAQ = [
  {
    q: 'How do I copy Markdown into Notion, Confluence, Google Docs, or Substack without losing formatting?',
    a: 'In SoloMD, click Edit → Copy as Rich HTML (or use the toolbar copy menu). Instead of copying raw # and ** symbols, SoloMD renders headings, nested lists, repaired GFM tables, syntax-highlighted code blocks, and math into clean inline-styled clipboard HTML that pastes directly into Notion, Confluence, Google Docs, Word, Apple Mail, and CMS editors.',
  },
  {
    q: 'Why do images break when pasting Markdown into web editors or publishing platforms?',
    a: 'Local relative paths like ./_assets/screenshot.png only exist on your hard drive, so browser-based rich-text editors cannot upload them automatically from Markdown text. SoloMD solves this with 5 built-in image hosting (CDN) backends — S3/Cloudflare R2/MinIO, GitHub Repo + jsDelivr/CDN, PicGo, SM.MS, and custom CLI scripts — uploading screenshots on paste and falling back to local _assets/ when offline.',
  },
  {
    q: 'Can SoloMD clean up broken tables and citation tags pasted from ChatGPT, Claude, or DeepSeek before copying?',
    a: 'Yes. SoloMD includes a one-click Clean AI Artifacts action that strips [cite_start], 【†source】 markers, zero-width characters, and smart quotes, while its v4.11 malformed-table auto-repair engine automatically fixes mismatched |---|---| delimiter columns before rendering to Rich HTML.',
  },
  {
    q: 'When is a dedicated browser extension or CMS-specific formatter still useful alongside SoloMD?',
    a: 'If you rely on proprietary interactive widgets (such as Notion database views, Confluence Jira macros, or custom WeChat SVG animation cards), you will still configure those widgets inside the target platform after pasting your formatted prose, code blocks, and CDN-backed images from SoloMD.',
  },
];
