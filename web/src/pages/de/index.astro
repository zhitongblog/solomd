---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import V5Showcase from '../../components/V5Showcase.astro';
import BuiltByClaude from '../../components/BuiltByClaude.astro';
import UseCases from '../../components/UseCases.astro';
import Principles from '../../components/Principles.astro';
import Features from '../../components/Features.astro';
import Compare from '../../components/Compare.astro';
import Download from '../../components/Download.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Sponsor from '../../components/Sponsor.astro';
import Footer from '../../components/Footer.astro';

const lang = 'de' as const;
---

<Layout
  title="SoloMD — Die Ruhe von Typora + kostenlose 5-Plattform-Synchronisation & lokale KI (Open-Source Markdown-Editor)"
  description="Pure-WYSIWYG-Schreiben wie in Typora, kombiniert mit verschlüsselter 5-Plattform-Synchronisation (macOS, Windows, Linux, iOS & Android), integriertem 9-Format-Export (ohne Pandoc), lokaler RAG-Suche, 20+ BYOK-/lokalen KI-Anbietern (Ollama, LM Studio) und 16-Tool-MCP-Server. ~14–30 MB, MIT-Lizenz, 0 €."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
