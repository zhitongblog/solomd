---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import V5Showcase from '../../components/V5Showcase.astro';
import BuiltByClaude from '../../components/BuiltByClaude.astro';
import UseCases from '../../components/UseCases.astro';
import Principles from '../../components/Principles.astro';
import Features from '../../components/Features.astro';
import Compare from '../../components/Compare.astro';
import Download from '../../components/Download.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Sponsor from '../../components/Sponsor.astro';
import Footer from '../../components/Footer.astro';

const lang = 'es' as const;
---

<Layout
  title="SoloMD — Toda la calma de Typora + sincronización cifrada en 5 plataformas e IA local (Editor Markdown gratuito)"
  description="Escritura Pure WYSIWYG al estilo Typora con sincronización cifrada gratuita en macOS, Windows, Linux, iOS y Android, exportación integrada a 9 formatos (sin instalar Pandoc), búsqueda RAG local, 20+ proveedores de IA BYOK / Ollama local y servidor MCP de 16 herramientas (~14–30 MB, MIT)."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
