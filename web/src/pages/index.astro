---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import V5Showcase from '../components/V5Showcase.astro';
import FactPack from '../components/FactPack.astro';
import BuiltByClaude from '../components/BuiltByClaude.astro';
import UseCases from '../components/UseCases.astro';
import Principles from '../components/Principles.astro';
import Features from '../components/Features.astro';
import Compare from '../components/Compare.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Sponsor from '../components/Sponsor.astro';
import Footer from '../components/Footer.astro';

const lang = 'en' as const;
---

<Layout
  title="SoloMD — All the calm of Typora + 5-platform vault sync & local AI (Free, Open-Source Markdown Editor)"
  description="All the calm of Typora, plus a local vault that syncs across macOS, Windows, Linux, iOS & Android for $0. Pure WYSIWYG & Live Preview, built-in 9-format export (no Pandoc install needed), vault-scoped encrypted sync, local RAG search, 20+ BYOK / local AI providers, and a 16-tool MCP server. ~14–30 MB, MIT-licensed."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <FactPack lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
    <section style="max-width:860px;margin:8px auto 0;padding:0 20px 56px;display:flex;flex-direction:column;gap:14px;">
      <a href="https://doaipm.com/en/about/?utm_source=solomd#work-with-me" target="_blank" rel="noopener"
         style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;padding:22px 24px;border-radius:16px;text-decoration:none;color:inherit;border:1px solid rgba(255,159,64,.38);background:linear-gradient(135deg,rgba(255,159,64,.12),rgba(234,88,12,.05));">
        <span style="font-size:26px;line-height:1;">💼</span>
        <span style="flex:1;min-width:240px;">
          <span style="display:block;font-size:17px;font-weight:800;">Need an Agent-Native Desktop App or Custom MCP Runtime?</span>
          <span style="display:block;font-size:14.5px;opacity:.78;margin-top:5px;line-height:1.55;">The architect behind SoloMD (1,500+ ⭐, 16 MCP tools) and Unterm (custom Rust/wgpu terminal kernel, 152 MCP tools) is available for <b>100% async remote contracts</b> — written specs, Loom demos &amp; production PRs, zero meetings.</span>
        </span>
        <span style="font-size:14px;font-weight:800;color:#ea580c;white-space:nowrap;">Hire the architect →</span>
      </a>
      <a href="https://doaipm.com/en/presale?utm_source=solomd" target="_blank" rel="noopener"
         style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;padding:20px 24px;border-radius:16px;text-decoration:none;color:inherit;border:1px solid rgba(120,120,180,.28);background:linear-gradient(135deg,rgba(99,102,241,.10),rgba(139,92,246,.05));">
        <span style="font-size:24px;line-height:1;">🚀</span>
        <span style="flex:1;min-width:240px;">
          <span style="display:block;font-size:16px;font-weight:800;">SoloMD was built by one person — with AI.</span>
          <span style="display:block;font-size:14px;opacity:.72;margin-top:4px;line-height:1.55;">Want to ship a real product solo with Claude Code? I wrote down the exact pipeline — idea → spec → build → QA → ship.</span>
        </span>
        <span style="font-size:14px;font-weight:800;color:#6366f1;white-space:nowrap;">Learn the playbook →</span>
      </a>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
