---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import V5Showcase from '../../components/V5Showcase.astro';
import BuiltByClaude from '../../components/BuiltByClaude.astro';
import UseCases from '../../components/UseCases.astro';
import Principles from '../../components/Principles.astro';
import Features from '../../components/Features.astro';
import Compare from '../../components/Compare.astro';
import Download from '../../components/Download.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import Sponsor from '../../components/Sponsor.astro';
import Footer from '../../components/Footer.astro';

const lang = 'tr' as const;
---

<Layout
  title="SoloMD — Typora’nın dinginliği + 5 platformda ücretsiz şifreli senkronizasyon ve yerel AI (Açık Kaynak Markdown Editörü)"
  description="Typora tarzı Pure WYSIWYG yazım deneyimi; macOS, Windows, Linux, iOS ve Android arasında ücretsiz şifreli senkronizasyon, Pandoc gerektirmeyen 9 formatlı dışa aktarma, yerel RAG arama, 20+ BYOK / yerel Ollama AI sağlayıcısı ve 16 araçlı MCP sunucusu (~14–30 MB, MIT)."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <V5Showcase lang={lang} />
    <BuiltByClaude lang={lang} />
    <UseCases lang={lang} />
    <Principles lang={lang} />
    <Features lang={lang} />
    <Compare lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
