---
import '../styles/global.css';
import type { Lang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Pages that must never be indexed (404, admin). Suppresses canonical +
      hreflang too — a 404 pointing canonical at `/` is how soft-404s start. */
  noindex?: boolean;
}

const {
  title = 'SoloMD — Lightweight Markdown editor',
  description = 'A lightweight, cross-platform Markdown + plain text editor.',
  lang = 'en',
  noindex = false,
} = Astro.props;

const HTML_LANG = { en: 'en', zh: 'zh-CN', ja: 'ja', ko: 'ko', de: 'de', fr: 'fr', es: 'es', pt: 'pt', it: 'it', pl: 'pl', nl: 'nl', tr: 'tr', sv: 'sv', uk: 'uk' } as const;
const OG_LOCALE = { en: 'en_US', zh: 'zh_CN', ja: 'ja_JP', ko: 'ko_KR', de: 'de_DE', fr: 'fr_FR', es: 'es_ES', pt: 'pt_BR', it: 'it_IT', pl: 'pl_PL', nl: 'nl_NL', tr: 'tr_TR', sv: 'sv_SE', uk: 'uk_UA' } as const;
const htmlLang = HTML_LANG[lang];
/* The real path of the page being rendered. This used to be derived from
   `lang` alone (`/` or `/zh/`), which meant EVERY sub-page — all of /docs/,
   /blog/, /compare/ — declared the language homepage as its canonical and its
   og:url. That tells search engines those pages are duplicates of the home
   page and should not be indexed on their own, and it made every shared link
   preview show the homepage's URL. Astro.url.pathname is the actual route. */
const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
/* The hreflang block below lists the language HOME pages, which is only true
   for a language home page. On a sub-page it would claim, e.g., that the
   Chinese version of /docs/sync/ is /zh/ — wrong, and worse than saying
   nothing. So only emit it where it holds. */
const isLangHome = path === '/' || /^\/[a-z]{2}\/$/.test(path);
const ogLocale = OG_LOCALE[lang];
const ogImage = lang === 'zh' ? 'https://solomd.app/og-image-zh.png' : 'https://solomd.app/og-image.png';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        {isLangHome && (
        <>
        <link rel="alternate" hreflang="en" href="https://solomd.app/" />
        <link rel="alternate" hreflang="zh-CN" href="https://solomd.app/zh/" />
        <link rel="alternate" hreflang="ja" href="https://solomd.app/ja/" />
        <link rel="alternate" hreflang="ko" href="https://solomd.app/ko/" />
        <link rel="alternate" hreflang="de" href="https://solomd.app/de/" />
        <link rel="alternate" hreflang="fr" href="https://solomd.app/fr/" />
        <link rel="alternate" hreflang="es" href="https://solomd.app/es/" />
        <link rel="alternate" hreflang="pt" href="https://solomd.app/pt/" />
        <link rel="alternate" hreflang="it" href="https://solomd.app/it/" />
        <link rel="alternate" hreflang="pl" href="https://solomd.app/pl/" />
        <link rel="alternate" hreflang="nl" href="https://solomd.app/nl/" />
        <link rel="alternate" hreflang="tr" href="https://solomd.app/tr/" />
        <link rel="alternate" hreflang="sv" href="https://solomd.app/sv/" />
        <link rel="alternate" hreflang="uk" href="https://solomd.app/uk/" />
        <link rel="alternate" hreflang="x-default" href="https://solomd.app/" />
        </>
        )}
        <link rel="canonical" href={`https://solomd.app${path}`} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://solomd.app${path}`} />
    <meta property="og:site_name" content="SoloMD" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ff9f40" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg?v=4.11.4" type="image/svg+xml" />

    <!-- 5.0: no web font. Headings use the system display face, as the app
         does (styles/global.css --font-serif), so nothing waits on a font
         file — which also mattered for visitors who cannot reach a CDN. -->

    <!-- Sitemap discovery hint -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "SoloMD", "item": "https://solomd.app/" },
        ...(lang === 'zh' ? [{ "@type": "ListItem", "position": 2, "name": "中文", "item": "https://solomd.app/zh/" }] : []),
        ...(lang === 'ja' ? [{ "@type": "ListItem", "position": 2, "name": "日本語", "item": "https://solomd.app/ja/" }] : []),
        ...(lang === 'ko' ? [{ "@type": "ListItem", "position": 2, "name": "한국어", "item": "https://solomd.app/ko/" }] : []),
        ...(lang === 'de' ? [{ "@type": "ListItem", "position": 2, "name": "Deutsch", "item": "https://solomd.app/de/" }] : []),
        ...(lang === 'fr' ? [{ "@type": "ListItem", "position": 2, "name": "Français", "item": "https://solomd.app/fr/" }] : []),
        ...(lang === 'es' ? [{ "@type": "ListItem", "position": 2, "name": "Español", "item": "https://solomd.app/es/" }] : []),
        ...(lang === 'pt' ? [{ "@type": "ListItem", "position": 2, "name": "Português", "item": "https://solomd.app/pt/" }] : []),
        ...(lang === 'it' ? [{ "@type": "ListItem", "position": 2, "name": "Italiano", "item": "https://solomd.app/it/" }] : []),
        ...(lang === 'pl' ? [{ "@type": "ListItem", "position": 2, "name": "Polski", "item": "https://solomd.app/pl/" }] : []),
        ...(lang === 'nl' ? [{ "@type": "ListItem", "position": 2, "name": "Nederlands", "item": "https://solomd.app/nl/" }] : []),
        ...(lang === 'tr' ? [{ "@type": "ListItem", "position": 2, "name": "Türkçe", "item": "https://solomd.app/tr/" }] : []),
        ...(lang === 'sv' ? [{ "@type": "ListItem", "position": 2, "name": "Svenska", "item": "https://solomd.app/sv/" }] : []),
        ...(lang === 'uk' ? [{ "@type": "ListItem", "position": 2, "name": "Українська", "item": "https://solomd.app/uk/" }] : []),
      ]
    })} />

    <!-- JSON-LD: SoftwareApplication (helps Google software result cards + LLM citations) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "SoloMD",
      "alternateName": ["#MD", "Solo MD", "free Typora alternative", "open-source Obsidian alternative"],
      "description": "Free, open-source Markdown editor for macOS, Windows, Linux, Android, and iOS — a free alternative to Typora with the same live WYSIWYG preview, and an open-source alternative to Obsidian for local, folder-based notes. ~15 MB installer, MIT license, offline-first, no accounts, no in-app purchases, no ads. Ships live preview, Wiki links, local RAG, 14 BYOK AI providers, themes, AutoGit, MCP server, and Pomodoro in core.",
      "applicationCategory": "ProductivityApplication",
      "applicationSubCategory": "Markdown Editor",
      "operatingSystem": "macOS, Windows, Linux, Android, iOS",
      "softwareVersion": "4.14.10",
      "datePublished": "2026-05-17",
      "dateModified": "2026-10-07",
      "releaseNotes": "https://solomd.app/whats-new/",
      "fileSize": "15MB",
      "url": "https://solomd.app",
      "downloadUrl": "https://github.com/zhitongblog/solomd/releases/latest",
      "license": "https://opensource.org/licenses/MIT",
      "softwareRequirements": "macOS 11+ · Windows 10+ · Linux x64/ARM64 · Android 7+ (API 24) · iOS 15+",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
      },
      "author": {
        "@type": "Person",
        "name": "xiangdong li",
        "url": "https://github.com/zhitongblog",
      },
      "publisher": {
        "@type": "Person",
        "name": "xiangdong li",
      },
      "featureList": [
        "Live Preview Markdown editor (Typora-style WYSIWYG)",
        "Native-textarea block editor on Windows — reliable CJK IME input (avoids WebView2 contentEditable bugs)",
        "tldraw whiteboards embedded in Markdown (```tldraw fence)",
        "Knowledge graph: typed relationships with automatic inverses, per-note Neighborhood graph, type-driven sidebar",
        "Properties inspector — frontmatter editor with date / relation / status / tag pickers",
        "Saved filtered views (.solomd/views/*.yml) in the sidebar",
        "Image hosting upload (图床) — PicGo, custom command, SM.MS, S3-compatible, GitHub CDN",
        "Wiki links with outline + backlinks panel",
        "Local RAG / semantic search (on-device embedder, zero cloud calls)",
        "14 BYOK AI providers — OpenAI, Claude, Gemini, xAI, Mistral, Groq, DeepSeek, Qwen, GLM, Kimi, Doubao, SiliconFlow, OpenRouter, Ollama",
        "AutoGit — every save becomes a local commit with one-click restore",
        "MCP server bundled for Claude Desktop / Cursor / Codex CLI",
        "Pomodoro timer with writing goals and streak counter",
        "8 built-in themes plus custom CSS injection",
        "KaTeX math + Mermaid diagrams + 13-language syntax highlighting",
        "Image paste & drag-drop (auto-saves to _assets/)",
        "Slideshow mode (Cmd+Opt+P renders active doc as slides)",
        "Vim mode with full emulation including macros and registers",
        "Pandoc export to PDF, DOCX, EPUB, ODT, LaTeX, RTF",
        "Markdown converter for .docx / .pdf / .xlsx / .pptx / .csv input",
        "Multi-encoding support (UTF-8, UTF-16, GBK, GB18030, Big5, Shift_JIS auto-detect)",
        "Chinese-first: CJK word count, Simplified ↔ Traditional, pinyin export",
        "Multi-window + tabs + file tree + ripgrep global search",
        "Command palette (Cmd+Shift+K)",
        "Notes stay on your device; anonymous usage stats can be turned off",
        "Offline-first: no accounts, no cloud lock-in",
      ],
      "inLanguage": ["en", "zh-CN", "ja", "ko", "de", "fr", "es", "pt", "it", "pl", "nl", "tr", "sv", "uk"],
    })} />

    <!-- JSON-LD: HowTo (install SoloMD) — helps Google + LLMs cite install steps -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to install SoloMD",
      "description": "Install SoloMD, the free open-source Markdown editor, on macOS, Windows, Linux, Android, or iOS.",
      "totalTime": "PT2M",
      "supply": [{ "@type": "HowToSupply", "name": "A terminal (macOS/Linux) or PowerShell (Windows)" }],
      "tool": [{ "@type": "HowToTool", "name": "curl or PowerShell" }],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "macOS / Linux — one-line install",
          "text": "Open a terminal and run: curl -fsSL https://solomd.app/install.sh | bash. The script auto-detects your OS and CPU architecture, downloads the latest .dmg / .deb / .AppImage from GitHub Releases, and installs it.",
          "url": "https://solomd.app/install.sh",
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Windows — one-line install",
          "text": "Open PowerShell and run: irm https://solomd.app/install.ps1 | iex. Downloads SoloMD_4.14.10_x64_en-US.msi from GitHub Releases and runs the installer.",
          "url": "https://solomd.app/install.ps1",
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Android — Google Play or sideload",
          "text": "Install SoloMD from Google Play (https://play.google.com/store/apps/details?id=app.solomd), or download SoloMD_4.14.10_universal.apk from https://github.com/zhitongblog/solomd/releases/latest and tap to install (allow installs from unknown sources).",
          "url": "https://play.google.com/store/apps/details?id=app.solomd",
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "iOS, iPadOS and Mac — App Store",
          "text": "Install SoloMD from the App Store (iPhone and iPad need iOS 15+; the same listing serves the Mac).",
          "url": "https://apps.apple.com/app/id6762498874",
        },
      ],
    })} />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-7786364053868586">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7786364053868586" crossorigin="anonymous"></script>
  </head>
  <body>
    <!-- Keyboard users land on the nav on every page; this lets them jump the
         whole header in one Tab. Visually hidden until focused. -->
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <slot />
      <!-- Promoter referral codes (solomd.app/?ref=<code>, see /promote). Does
         nothing for a visit without a code. With one: the code is kept for 30
         days so a later download counts too, and two events go to /api/track —
         ref_visit and ref_download — carrying only the code, the page path and
         a random per-browser id. No IP, user agent or cookie is stored. -->
    <script is:inline>
      (function () {
        var KEY = 'solomd.ref', ANON = 'solomd.anon', WINDOW = 30 * 24 * 3600 * 1000;
        var CODE = /^[a-z0-9-]{1,40}$/;
        function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function anon() {
          var id = get(ANON);
          if (!id && window.crypto && crypto.randomUUID) { id = crypto.randomUUID(); set(ANON, id); }
          return id;
        }
        function send(event, props) {
          var id = anon();
          if (!id) return;
          var body = JSON.stringify({ event: event, anon_id: id, os: 'web', props: props });
          try {
            if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
            else fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true });
          } catch (e) {}
        }
        var url;
        try { url = new URL(location.href); } catch (e) { return; }
        var fresh = (url.searchParams.get('ref') || '').trim().toLowerCase();
        if (CODE.test(fresh)) {
          set(KEY, JSON.stringify({ ref: fresh, at: Date.now() }));
          send('ref_visit', { ref: fresh, path: location.pathname });
          // Keep shared URLs clean: drop the code from the address bar.
          url.searchParams.delete('ref');
          try { history.replaceState(null, '', url.pathname + url.search + url.hash); } catch (e) {}
        }
        function current() {
          try {
            var v = JSON.parse(get(KEY) || 'null');
            return v && CODE.test(v.ref) && Date.now() - v.at < WINDOW ? v.ref : null;
          } catch (e) { return null; }
        }
        var DOWNLOAD = /\/releases\/download\/|apps\.apple\.com|play\.google\.com\/store|apps\.microsoft\.com|gitee\.com\/[^/]+\/solomd\/releases/;
        document.addEventListener('click', function (e) {
          var ref = current();
          if (!ref || !e.target || !e.target.closest) return;
          var a = e.target.closest('a[href]');
          var copy = e.target.closest('.hi-copy');
          if ((a && DOWNLOAD.test(a.href)) || copy) {
            send('ref_download', { ref: ref, kind: copy ? 'install-command' : a.hostname });
          }
        }, true);
      })();
    </script>
</body>
</html>
