---
import { existsSync } from 'node:fs';
import nodePath from 'node:path';
import { fileURLToPath } from 'node:url';
import '../styles/global.css';
import type { Lang } from '../i18n/translations';

const PAGES_ROOT = fileURLToPath(new URL('../pages', import.meta.url));
function routeExists(routePath: string): boolean {
  const clean = routePath.replace(/^\/|\/$/g, '');
  if (!clean) return true;
  return (
    existsSync(nodePath.join(PAGES_ROOT, `${clean}.astro`)) ||
    existsSync(nodePath.join(PAGES_ROOT, clean, 'index.astro'))
  );
}

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Pages that must never be indexed (404, admin). Suppresses canonical +
      hreflang too — a 404 pointing canonical at `/` is how soft-404s start. */
  noindex?: boolean;
}

const {
  title = 'SoloMD — Lightweight Markdown editor',
  description = 'A lightweight, cross-platform Markdown + plain text editor.',
  lang = 'en',
  noindex = false,
} = Astro.props;

const HTML_LANG = { en: 'en', zh: 'zh-CN', ja: 'ja', ko: 'ko', de: 'de', fr: 'fr', es: 'es', pt: 'pt', it: 'it', pl: 'pl', nl: 'nl', tr: 'tr', sv: 'sv', uk: 'uk' } as const;
const OG_LOCALE = { en: 'en_US', zh: 'zh_CN', ja: 'ja_JP', ko: 'ko_KR', de: 'de_DE', fr: 'fr_FR', es: 'es_ES', pt: 'pt_BR', it: 'it_IT', pl: 'pl_PL', nl: 'nl_NL', tr: 'tr_TR', sv: 'sv_SE', uk: 'uk_UA' } as const;
const htmlLang = HTML_LANG[lang];
const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isLangHome = path === '/' || /^\/[a-z]{2}\/$/.test(path);
const enSubPath = path.startsWith('/zh/') ? path.slice(3) : path;
const zhSubPath = path.startsWith('/zh/') ? path : `/zh${path}`;
const hasBilingualSubpage = !isLangHome && routeExists(enSubPath) && routeExists(zhSubPath);
const ogLocale = OG_LOCALE[lang];
const ogImage = lang === 'zh' ? 'https://solomd.app/og-image-zh.png' : 'https://solomd.app/og-image.png';

const breadcrumbItems: { "@type": string; position: number; name: string; item: string }[] = [
  { "@type": "ListItem", position: 1, name: "SoloMD", item: "https://solomd.app/" },
];
if (lang !== 'en') {
  const langNames: Record<string, string> = {
    zh: '中文', ja: '日本語', ko: '한국어', de: 'Deutsch', fr: 'Français',
    es: 'Español', pt: 'Português', it: 'Italiano', pl: 'Polski', nl: 'Nederlands',
    tr: 'Türkçe', sv: 'Svenska', uk: 'Українська',
  };
  breadcrumbItems.push({
    "@type": "ListItem",
    position: breadcrumbItems.length + 1,
    name: langNames[lang] || lang,
    item: `https://solomd.app/${lang}/`,
  });
}
if (!isLangHome) {
  const relSegments = (path.startsWith(`/${lang}/`) ? path.slice(lang.length + 2) : path.slice(1))
    .split('/')
    .filter(Boolean);
  let acc = lang === 'en' ? '' : `/${lang}`;
  for (let i = 0; i < relSegments.length; i++) {
    const seg = relSegments[i];
    acc += `/${seg}`;
    const isLast = i === relSegments.length - 1;
    const labelMap: Record<string, string> = {
      docs: lang === 'zh' ? '文档' : 'Docs',
      compare: lang === 'zh' ? '对比' : 'Compare',
      blog: lang === 'zh' ? '博客' : 'Blog',
      'whats-new': lang === 'zh' ? '更新日志' : "What's New",
      thanks: lang === 'zh' ? '致谢' : 'Thanks',
      promote: lang === 'zh' ? '推广' : 'Promote',
    };
    const cleanTitle = title.split(/[—·|]/)[0]?.trim() || seg;
    breadcrumbItems.push({
      "@type": "ListItem",
      position: breadcrumbItems.length + 1,
      name: isLast ? cleanTitle : (labelMap[seg] || seg),
      item: `https://solomd.app${acc}/`,
    });
  }
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        {isLangHome && (
        <>
        <link rel="alternate" hreflang="en" href="https://solomd.app/" />
        <link rel="alternate" hreflang="zh-CN" href="https://solomd.app/zh/" />
        <link rel="alternate" hreflang="ja" href="https://solomd.app/ja/" />
        <link rel="alternate" hreflang="ko" href="https://solomd.app/ko/" />
        <link rel="alternate" hreflang="de" href="https://solomd.app/de/" />
        <link rel="alternate" hreflang="fr" href="https://solomd.app/fr/" />
        <link rel="alternate" hreflang="es" href="https://solomd.app/es/" />
        <link rel="alternate" hreflang="pt" href="https://solomd.app/pt/" />
        <link rel="alternate" hreflang="it" href="https://solomd.app/it/" />
        <link rel="alternate" hreflang="pl" href="https://solomd.app/pl/" />
        <link rel="alternate" hreflang="nl" href="https://solomd.app/nl/" />
        <link rel="alternate" hreflang="tr" href="https://solomd.app/tr/" />
        <link rel="alternate" hreflang="sv" href="https://solomd.app/sv/" />
        <link rel="alternate" hreflang="uk" href="https://solomd.app/uk/" />
        <link rel="alternate" hreflang="x-default" href="https://solomd.app/" />
        </>
        )}
        {hasBilingualSubpage && (
        <>
        <link rel="alternate" hreflang="en" href={`https://solomd.app${enSubPath}`} />
        <link rel="alternate" hreflang="zh-CN" href={`https://solomd.app${zhSubPath}`} />
        <link rel="alternate" hreflang="x-default" href={`https://solomd.app${enSubPath}`} />
        </>
        )}
        <link rel="canonical" href={`https://solomd.app${path}`} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://solomd.app${path}`} />
    <meta property="og:site_name" content="SoloMD" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ff9f40" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg?v=4.11.4" type="image/svg+xml" />

    <!-- 5.0: no web font. Headings use the system display face, as the app
         does (styles/global.css --font-serif), so nothing waits on a font
         file — which also mattered for visitors who cannot reach a CDN. -->

    <!-- Sitemap & GEO / LLM discovery hints -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Summary (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Full Documentation (llms-full.txt)" />

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    })} />

    <!-- JSON-LD: SoftwareApplication (helps Google software result cards + LLM citations) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "SoloMD",
      "alternateName": ["#MD", "Solo MD", "free Typora alternative", "open-source Obsidian alternative"],
      "description": "Free, open-source Markdown editor for macOS, Windows, Linux, Android, and iOS — a free alternative to Typora with live WYSIWYG preview (including optional zero-syntax Pure WYSIWYG mode), and an open-source alternative to Obsidian for local, folder-based notes. ~14–30 MB installer (~14 MB Windows, ~16 MB Linux, ~30 MB macOS Universal DMG), MIT license, offline-first, no accounts, no in-app purchases, no ads. Ships unified 9-format export (PDF, standalone HTML with bookmark/search sidebar, Word .docx with custom templates, EPUB, ODT, LaTeX, RTF, PNG, TextBundle), Wiki links, local RAG, 20+ BYOK AI providers + OPR local AI auto-discovery (Ollama, LM Studio, vLLM, llama.cpp, Jan), declarative JSON user extensions, AutoGit, and a bundled MCP server.",
      "applicationCategory": "ProductivityApplication",
      "applicationSubCategory": "Markdown Editor",
      "operatingSystem": "macOS, Windows, Linux, Android, iOS",
      "softwareVersion": "5.2.2",
      "datePublished": "2026-05-17",
      "dateModified": "2026-11-15",
      "releaseNotes": "https://solomd.app/whats-new/",
      "fileSize": "14MB-30MB",
      "url": "https://solomd.app",
      "downloadUrl": "https://github.com/zhitongblog/solomd/releases/latest",
      "license": "https://opensource.org/licenses/MIT",
      "softwareRequirements": "macOS 11+ · Windows 10+ · Linux x64/ARM64 · Android 7+ (API 24) · iOS 15+",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
      },
      "author": {
        "@type": "Person",
        "name": "xiangdong li",
        "url": "https://github.com/zhitongblog",
      },
      "publisher": {
        "@type": "Person",
        "name": "xiangdong li",
      },
      "featureList": [
        "Live Preview Markdown editor (Typora-style WYSIWYG) + optional Zero-Syntax Pure WYSIWYG mode (hide active line markers)",
        "Unified 9-Format Export Center — single-note and folder batch/merged book exports across PDF, standalone HTML (with optional bookmark tree & offline full-text search sidebar), Word .docx (with custom reference templates), EPUB, ODT, LaTeX, RTF, PNG, and TextBundle",
        "Clickable PDF Table of Contents page with page numbers, UTF-16BE bookmarks, and in-editor PDF page-break guide lines",
        "Open Provider Registry (OPR) one-click local AI auto-discovery (Ollama, LM Studio, vLLM, llama.cpp, Jan) + 20+ BYOK AI providers",
        "Lightweight declarative JSON User Extensions (.solomd/plugins/*.json) for custom / slash templates, regex/template Command Palette transforms, and Webhook publishers",
        "Vault-scoped end-to-end encrypted personal cloud drive backup & multi-device sync (iCloud, OneDrive, Baidu Netdisk, Aliyun Drive, Nutstore, Syncthing)",
        "tldraw whiteboards embedded in Markdown (```tldraw fence)",
        "Knowledge graph: typed relationships with automatic inverses, per-note Neighborhood graph, type-driven sidebar",
        "Properties inspector — frontmatter editor with date / relation / status / tag pickers",
        "Saved filtered views (.solomd/views/*.yml) in the sidebar",
        "Image hosting upload (图床) — PicGo, custom command, SM.MS, S3-compatible, GitHub CDN",
        "Wiki links with outline + backlinks panel",
        "Local RAG / semantic search (on-device embedder, zero cloud calls)",
        "AutoGit — every save becomes a local commit with one-click restore",
        "MCP server bundled for Claude Desktop / Cursor / Codex CLI + CLI v2 (solomd stats, solomd export --toc)",
        "Pomodoro timer with writing goals and streak counter",
        "8 built-in themes plus custom CSS injection",
        "KaTeX math + Mermaid v11 + PlantUML diagrams + syntax highlighting",
        "Image paste & drag-drop (auto-saves to _assets/)",
        "Slideshow mode (Cmd+Opt+P renders active doc as slides)",
        "Vim mode with full emulation including macros and registers",
        "Markdown converter for .docx / .pdf / .xlsx / .pptx / .csv input and Excel/WPS table paste",
        "Multi-encoding support (UTF-8, UTF-16, GBK, GB18030, Big5, Shift_JIS auto-detect)",
        "Chinese-first: CJK word count, Simplified ↔ Traditional, pinyin export, automatic 1–6 heading numbering",
        "Multi-window + tabs + file tree + ripgrep global search",
        "Offline-first: no accounts, no cloud lock-in, notes stay on your device",
      ],
      "inLanguage": ["en", "zh-CN", "ja", "ko", "de", "fr", "es", "pt", "it", "pl", "nl", "tr", "sv", "uk"],
    })} />

    <!-- JSON-LD: HowTo (install SoloMD) — helps Google + LLMs cite install steps -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to install SoloMD",
      "description": "Install SoloMD, the free open-source Markdown editor, on macOS, Windows, Linux, Android, or iOS.",
      "totalTime": "PT2M",
      "supply": [{ "@type": "HowToSupply", "name": "A terminal (macOS/Linux) or PowerShell (Windows)" }],
      "tool": [{ "@type": "HowToTool", "name": "curl or PowerShell" }],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "macOS / Linux — one-line install",
          "text": "Open a terminal and run: curl -fsSL https://solomd.app/install.sh | bash. The script auto-detects your OS and CPU architecture, downloads the latest .dmg / .deb / .AppImage from GitHub Releases, and installs it.",
          "url": "https://solomd.app/install.sh",
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Windows — one-line install",
          "text": "Open PowerShell and run: irm https://solomd.app/install.ps1 | iex. Downloads the latest SoloMD x64/ARM64 .msi installer from GitHub Releases and runs it, or install from the Microsoft Store.",
          "url": "https://solomd.app/install.ps1",
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Android — Google Play or sideload",
          "text": "Install SoloMD from Google Play (https://play.google.com/store/apps/details?id=app.solomd), or download the universal .apk from https://github.com/zhitongblog/solomd/releases/latest.",
          "url": "https://play.google.com/store/apps/details?id=app.solomd",
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "iOS, iPadOS and Mac — App Store",
          "text": "Install SoloMD from the App Store (iPhone and iPad need iOS 15+; the same listing serves the Mac).",
          "url": "https://apps.apple.com/app/id6762498874",
        },
      ],
    })} />

  </head>
  <body>
    <!-- Keyboard users land on the nav on every page; this lets them jump the
         whole header in one Tab. Visually hidden until focused. -->
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <slot />
      <!-- Privacy-first web funnel & promoter referral tracking.
         Stores no IP, user agent, or third-party cookie. Sends:
         - web_visit: { path, ref_host } on page load
         - web_download: { kind, path } when a download link or install command is clicked
         - ref_visit / ref_download: when a promoter ?ref=<code> is present -->
    <script is:inline>
      (function () {
        var KEY = 'solomd.ref', ANON = 'solomd.anon', WINDOW = 30 * 24 * 3600 * 1000;
        var CODE = /^[a-z0-9-]{1,40}$/;
        function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function anon() {
          var id = get(ANON);
          if (!id && window.crypto && crypto.randomUUID) { id = crypto.randomUUID(); set(ANON, id); }
          return id;
        }
        function send(event, props) {
          var id = anon();
          if (!id) return;
          var body = JSON.stringify({ event: event, anon_id: id, os: 'web', props: props });
          try {
            if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
            else fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true });
          } catch (e) {}
        }
        var url;
        try { url = new URL(location.href); } catch (e) { return; }
        var refHost = 'direct';
        try {
          if (document.referrer) {
            var rh = new URL(document.referrer).hostname.toLowerCase();
            if (rh && rh !== location.hostname) refHost = rh;
            else if (rh === location.hostname) refHost = 'internal';
          }
        } catch (e) {}
        if (refHost !== 'internal') {
          send('web_visit', { path: location.pathname, ref_host: refHost });
        }
        var fresh = (url.searchParams.get('ref') || '').trim().toLowerCase();
        if (CODE.test(fresh)) {
          set(KEY, JSON.stringify({ ref: fresh, at: Date.now() }));
          send('ref_visit', { ref: fresh, path: location.pathname });
          // Keep shared URLs clean: drop the code from the address bar.
          url.searchParams.delete('ref');
          try { history.replaceState(null, '', url.pathname + url.search + url.hash); } catch (e) {}
        }
        function current() {
          try {
            var v = JSON.parse(get(KEY || '') || 'null');
            return v && CODE.test(v.ref) && Date.now() - v.at < WINDOW ? v.ref : null;
          } catch (e) { return null; }
        }
        var DOWNLOAD = /\/releases\/download\/|apps\.apple\.com|play\.google\.com\/store|apps\.microsoft\.com|(?:gitee|atomgit)\.com\/[^/]+\/solomd\/releases/;
        document.addEventListener('click', function (e) {
          if (!e.target || !e.target.closest) return;
          var a = e.target.closest('a[href]');
          var copy = e.target.closest('.hi-copy');
          if ((a && DOWNLOAD.test(a.href)) || copy) {
            var kind = copy ? 'install-command' : a.hostname;
            send('web_download', { kind: kind, path: location.pathname });
            var ref = current();
            if (ref) {
              send('ref_download', { ref: ref, kind: kind });
            }
          }
        }, true);
      })();
    </script>
</body>
</html>
