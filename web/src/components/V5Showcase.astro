const SHOTS = [
  { src: '/v5/mac-focus.webp', dark: '/v5/mac-focus-dark.webp', w: 1600, h: 983 },
  { src: '/v5/mac-bubble.webp', dark: '/v5/mac-bubble-dark.webp', w: 1680, h: 850, crop: true },
  { src: '/v5/mac-split.webp', dark: '/v5/mac-split-dark.webp', w: 1600, h: 983 },
];
---

<section class="v5" id="v5">
  <div class="v5__head">
    <p class="v5__eyebrow">{c.eyebrow}</p>
    <h2 class="v5__title">{c.title}</h2>
    <p class="v5__lead">{c.lead}</p>
  </div>

  {c.rows.map((row, i) => (
    <div class={`v5__row ${i % 2 ? 'v5__row--flip' : ''}`}>
      <div class="v5__text">
        <h3>{row.title}</h3>
        <p>{row.body}</p>
      </div>
      <figure class="v5__shot">
        <picture>
          <source srcset={SHOTS[i].dark} media="(prefers-color-scheme: dark)" type="image/webp" />
          <img src={SHOTS[i].src} alt={row.alt} width={SHOTS[i].w} height={SHOTS[i].h} loading="lazy" decoding="async" class={SHOTS[i].crop ? 'v5__crop' : ''} />
        </picture>
      </figure>
    </div>
  ))}

  <div class="v5__platforms">
    <h2 class="v5__title v5__title--sm">{c.platformsTitle}</h2>
    <p class="v5__lead">{c.platformsLead}</p>
    <div class="v5__devices">
      <figure class="v5__device v5__device--win">
        <img src="/v5/windows-light.webp" alt="SoloMD 5.0 on Windows" width="1496" height="815" loading="lazy" decoding="async" />
        <figcaption>Windows</figcaption>
      </figure>
      <figure class="v5__device v5__device--pad">
        <div class="v5__bezel v5__bezel--pad"><img src="/v5/ipad-portrait.webp" alt="SoloMD 5.0 on iPad" width="951" height="1368" loading="lazy" decoding="async" /></div>
        <figcaption>iPad</figcaption>
      </figure>
      <figure class="v5__device v5__device--phone">
        <div class="v5__bezel v5__bezel--phone"><img src="/v5/phone-editor.webp" alt="SoloMD 5.0 on iPhone" width="627" height="1363" loading="lazy" decoding="async" /></div>
        <figcaption>iPhone</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .v5 {
    max-width: 1180px;
    margin: 0 auto;
    padding: 96px 24px 72px;
  }
  .v5__head {
    max-width: 760px;
    margin: 0 auto 72px;
    text-align: center;
  }
  .v5__eyebrow {
    margin: 0 0 12px;
    color: var(--accent-deep);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .v5__title {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .v5__title--sm { font-size: clamp(1.7rem, 3.4vw, 2.5rem); }
  .v5__lead {
    margin: 0 auto;
    max-width: 640px;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  .v5__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: center;
    gap: 56px;
    margin: 0 0 96px;
  }
  .v5__row--flip { grid-template-columns: minmax(0, 8fr) minmax(0, 5fr); }
  .v5__row--flip .v5__text { order: 2; }
  .v5__text h3 {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .v5__text p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .v5__shot { margin: 0; }
  .v5__shot img.v5__crop {
    border-radius: 16px;
    border: 1px solid var(--hairline);
    background: var(--bg);
    filter: none;
    box-shadow: 0 18px 40px -18px rgba(31, 30, 28, 0.25);
  }
  .v5__shot img,
  .v5__device--win img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 38px rgba(31, 30, 28, 0.18)) drop-shadow(0 4px 10px rgba(31, 30, 28, 0.1));
  }

  .v5__platforms { text-align: center; }
  .v5__devices {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 4.6fr) minmax(0, 2.6fr);
    align-items: end;
    gap: 28px;
    margin-top: 48px;
  }
  .v5__device { margin: 0; }
  .v5__device figcaption {
    margin-top: 14px;
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
  }
  .v5__device--win img { border-radius: 10px; }
  /* Device bezels drawn in CSS: dark rim, generous radius. */
  .v5__bezel {
    padding: 10px;
    background: #1d1d1f;
    box-shadow: 0 22px 40px -12px rgba(31, 30, 28, 0.3), inset 0 0 0 1.5px #3a3a3c;
  }
  .v5__bezel img { display: block; width: 100%; height: auto; }
  .v5__bezel--pad { border-radius: 28px; }
  .v5__bezel--pad img { border-radius: 18px; }
  .v5__bezel--phone { border-radius: 34px; padding: 8px; }
  .v5__bezel--phone img { border-radius: 27px; }

  @media (prefers-color-scheme: dark) {
    .v5__shot img,
    .v5__device--win img {
      filter: drop-shadow(0 22px 44px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 0.5px rgba(255, 255, 255, 0.25));
    }
    .v5__bezel { box-shadow: 0 22px 44px -12px rgba(0, 0, 0, 0.7), inset 0 0 0 1.5px #48484a; }
  }

  @media (max-width: 860px) {
    .v5 { padding: 72px 18px 56px; }
    .v5__head { margin-bottom: 48px; }
    .v5__row,
    .v5__row--flip {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 64px;
    }
    .v5__row--flip .v5__text { order: 0; }
    .v5__devices {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      gap: 18px;
    }
    .v5__device--win { grid-column: 1 / -1; }
  }
</style>
