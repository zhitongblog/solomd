---
import { getT, type Lang } from '../i18n/translations';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = getT(lang);

const VERSION = '4.14.10';
const REPO = 'zhitongblog/solomd';
// The Store ships both x64 and arm64 and picks for the machine, and it keeps
// the app updated — worth offering next to the MSI rather than only below it.
const MS_STORE = 'https://apps.microsoft.com/detail/9nxghk2ll1q4';

// What the Store is actually serving, read at build time. It is deliberately
// not assumed equal to VERSION: the Store trails the GitHub release for as
// long as a submission sits in certification, and pointing people at a "v4.12"
// badge over a 4.11 package would be worse than showing nothing.
//
// The pin is the fallback, not the source of truth — a deploy must not fail
// or block because Microsoft's catalogue is slow, so an unreachable endpoint
// just leaves the last known-good value in place. Bump it with each store
// submission; the live read above is what visitors normally see.
const MS_STORE_VERSION_PIN = '4.14.9';

async function readStoreVersion(): Promise<string> {
  const url =
    'https://displaycatalog.mp.microsoft.com/v7.0/products/9NXGHK2LL1Q4' +
    '?market=US&languages=en-us&fieldsTemplate=Details';
  try {
    const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data: any = await res.json();
    const names: string[] = [];
    for (const sku of data?.Product?.DisplaySkuAvailabilities ?? []) {
      for (const pkg of sku?.Sku?.Properties?.Packages ?? []) {
        if (pkg?.PackageFullName) names.push(pkg.PackageFullName);
      }
    }
    // zhitong.SoloMD_4.12.0.0_x64__3vmxy07xh2v3m -> 4.12.0
    const versions = names
      .map((n) => n.match(/_(\d+)\.(\d+)\.(\d+)\.\d+_/))
      .filter((m): m is RegExpMatchArray => Boolean(m))
      .map((m) => [Number(m[1]), Number(m[2]), Number(m[3])] as const);
    if (!versions.length) throw new Error('no packages in catalogue response');
    // Highest wins: an old package can linger until it is removed.
    versions.sort((a, b) => b[0] - a[0] || b[1] - a[1] || b[2] - a[2]);
    return versions[0].join('.');
  } catch (err) {
    console.warn(
      `[download] could not read the Microsoft Store version (${err instanceof Error ? err.message : err}); ` +
      `falling back to the pin ${MS_STORE_VERSION_PIN}`
    );
    return MS_STORE_VERSION_PIN;
  }
}

const msStoreVersion = await readStoreVersion();

// iOS and macOS are one App Store listing (universal purchase), so one link
// and one version serve both. Read at build time for the same reason as the
// Microsoft Store: the store trails GitHub while a build sits in review.
const APP_STORE = 'https://apps.apple.com/app/id6762498874';
const GOOGLE_PLAY = 'https://play.google.com/store/apps/details?id=app.solomd';
const GITEE_RELEASE = `https://gitee.com/zhitong45/solomd/releases/tag/v${VERSION}`;

async function readAppStoreVersion(): Promise<string | null> {
  try {
    const res = await fetch('https://itunes.apple.com/lookup?id=6762498874&country=us', {
      signal: AbortSignal.timeout(8000),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data: any = await res.json();
    return data?.results?.[0]?.version ?? null;
  } catch (err) {
    console.warn(`[download] could not read the App Store version (${err instanceof Error ? err.message : err})`);
    return null;
  }
}
const appStoreVersion = await readAppStoreVersion();

// Package managers. Each entry is shown only once the package really resolves
// to a current build, so the site never advertises a command that installs
// nothing (winget before its first merge) or something ancient (Scoop sat on
// 4.11.6 for weeks when its autoupdate URL broke). Checked at build time;
// an unreachable API hides the entry rather than guessing.
async function ghJson(path: string): Promise<any | null> {
  try {
    const res = await fetch(`https://api.github.com/${path}`, {
      signal: AbortSignal.timeout(8000),
      headers: { Accept: 'application/vnd.github+json' },
    });
    return res.ok ? await res.json() : null;
  } catch {
    return null;
  }
}
const minor = (v: string) => v.split('.').slice(0, 2).join('.');
async function wingetLive(): Promise<boolean> {
  const dir = await ghJson('repos/microsoft/winget-pkgs/contents/manifests/z/zhitong/SoloMD');
  return Array.isArray(dir) && dir.some((d: any) => minor(d?.name ?? '') === minor(VERSION));
}
async function scoopLive(): Promise<boolean> {
  const f = await ghJson('repos/ScoopInstaller/Extras/contents/bucket/solomd.json');
  try {
    const v = JSON.parse(Buffer.from(f?.content ?? '', 'base64').toString('utf8'))?.version ?? '';
    return minor(v) === minor(VERSION);
  } catch {
    return false;
  }
}
const [hasWinget, hasScoop] = await Promise.all([wingetLive(), scoopLive()]);
const packageManagers = [
  { name: 'Homebrew', os: 'macOS', cmd: 'brew install --cask zhitongblog/solomd/solomd' },
  hasWinget && { name: 'winget', os: 'Windows', cmd: 'winget install zhitong.SoloMD' },
  hasScoop && { name: 'Scoop', os: 'Windows', cmd: 'scoop bucket add extras\nscoop install solomd' },
  { name: 'AUR', os: 'Arch Linux', cmd: 'yay -S solomd-bin' },
].filter(Boolean) as { name: string; os: string; cmd: string }[];
const releaseUrl = (version: string) => `https://github.com/${REPO}/releases/download/v${version}`;

const platforms = [
  {
    icon: '🍎',
    key: 'macos' as const,
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_universal.dmg`,
  },
  {
    icon: '🪟',
    key: 'windows' as const,
    // Was held at 4.11.19 while the 4.11.20 x64 MSI tripped
    // `Trojan:Script/Sabsik.EN.A!ml`, a Defender machine-learning false
    // positive: Windows deleted the download mid-flight and Chrome reported
    // "virus detected". Restored to VERSION for 4.11.21 — the release
    // workflow's Defender gate scanned this exact MSI (engine 4.18.26070.9,
    // signatures 1.457.411.0) and reported it clean, which is the condition
    // this pin was waiting on. Pin it again if the verdict comes back.
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_x64_en-US.msi`,
    storeUrl: MS_STORE,
  },
  {
    icon: '🪟',
    key: 'windowsArm' as const,
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_arm64_en-US.msi`,
    storeUrl: MS_STORE,
  },
  {
    icon: '🐧',
    key: 'linux' as const,
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_amd64.AppImage`,
    secondaryFile: `SoloMD_${VERSION}_amd64.deb`,
    tertiaryFile: `SoloMD-${VERSION}-1.x86_64.rpm`,
  },
  {
    icon: '🍓',
    key: 'linuxArm' as const,
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_aarch64.AppImage`,
    secondaryFile: `SoloMD_${VERSION}_arm64.deb`,
    tertiaryFile: `SoloMD-${VERSION}-1.aarch64.rpm`,
  },
  {
    icon: '🤖',
    key: 'android' as const,
    version: VERSION,
    primaryFile: `SoloMD_${VERSION}_universal.apk`,
    secondaryFile: `SoloMD_${VERSION}_arm64-v8a.apk`,
    tertiaryFile: `SoloMD_${VERSION}_armeabi-v7a.apk`,
  },
];
---

<section id="download">
  <div class="container">
    <div class="download__header">
      <h2>{tr.download.heading} <span class="muted">v{VERSION}</span> <span class="muted" id="dl-section-count"></span></h2>
      <p class="lead">{tr.download.lead}</p>
    </div>

    <div class="download__stores">
      <p class="download__stores-heading">{tr.download.stores.heading}</p>
      <div class="store-row">
        <a class="store-badge" href={APP_STORE} target="_blank" rel="noopener">
          <span class="store-badge__name">{tr.download.stores.appStore}{appStoreVersion && <span class="store-badge__ver"> v{appStoreVersion}</span>}</span>
          <span class="store-badge__note">{tr.download.stores.appStoreNote}</span>
        </a>
        <a class="store-badge" href={GOOGLE_PLAY} target="_blank" rel="noopener">
          <span class="store-badge__name">{tr.download.stores.play}</span>
          <span class="store-badge__note">{tr.download.stores.playNote}</span>
        </a>
        <a class="store-badge" href={MS_STORE} target="_blank" rel="noopener">
          <span class="store-badge__name">{tr.download.stores.msStore}<span class="store-badge__ver"> v{msStoreVersion}</span></span>
          <span class="store-badge__note">{tr.download.stores.msStoreNote}</span>
        </a>
      </div>
    </div>

    <div class="download__grid">
      {platforms.map((p) => {
        const meta = tr.download.platforms[p.key];
        return (
          <article class="dl-card">
            <div class="dl-card__head">
              <div class="dl-card__icon">{p.icon}</div>
              <div>
                <h3>{meta.name}</h3>
                <div class="dl-card__note">{meta.note}</div>
              </div>
            </div>
            <a href={`${releaseUrl(p.version)}/${p.primaryFile}`} class="btn btn--primary dl-card__btn">
              {meta.primary}
            </a>
            {p.secondaryFile && 'secondary' in meta && (
              <a href={`${releaseUrl(p.version)}/${p.secondaryFile}`} class="dl-card__alt">
                — {meta.secondary}
              </a>
            )}
            {p.tertiaryFile && 'tertiary' in meta && (
              <a href={`${releaseUrl(p.version)}/${p.tertiaryFile}`} class="dl-card__alt">
                — {meta.tertiary}
              </a>
            )}
            {'storeUrl' in p && p.storeUrl && 'store' in meta && (
              <a href={p.storeUrl} class="dl-card__store" target="_blank" rel="noopener">
                {meta.store} <span class="dl-card__store-ver">v{msStoreVersion}</span> →
              </a>
            )}
          </article>
        );
      })}
    </div>
    <div class="download__notes">
      <div class="note"><strong>macOS</strong>: {tr.download.notes.macos}</div>
      <div class="note"><strong>Windows</strong>: {tr.download.notes.windows}</div>
      <div class="note">
        <strong>Linux</strong>: {tr.download.notes.linux}
        {' '}
        <a href={lang === 'zh' ? '/zh/docs/linux/' : '/docs/linux/'}>{lang === 'zh' ? '需要 Ubuntu 22.04 / Debian 12 或更新，不确定能不能装？→' : 'Needs Ubuntu 22.04 / Debian 12 or newer — will yours work? →'}</a>
      </div>
      <div class="note">
        <strong>Chrome</strong>: {tr.download.notes.verify}
        {' '}
        <a href={`${releaseUrl(VERSION)}/SHA256SUMS.txt`} target="_blank" rel="noopener">SHA256SUMS.txt →</a>
      </div>
    </div>
    <div class="download__pm">
      <h3>{tr.download.packageManagers.heading}</h3>
      <div class="pm-grid">
        {packageManagers.map((m) => (
          <div class="pm-item">
            <div class="pm-item__head"><strong>{m.name}</strong> <span class="muted">{m.os}</span></div>
            <button type="button" class="pm-copy" aria-label="Copy">⧉</button>
            <pre class="pm-item__cmd"><code>{m.cmd}</code></pre>
          </div>
        ))}
      </div>
      <p class="pm-note">{tr.download.packageManagers.note}</p>
    </div>
    <p class="download__all">
      {tr.download.allReleases}
      <a href={`https://github.com/${REPO}/releases`} target="_blank" rel="noopener">
        {tr.download.allReleasesLink}
      </a>
      <br />
      <a href={GITEE_RELEASE} target="_blank" rel="noopener">{tr.download.mirror}</a>
    </p>
  </div>
</section>

<style>
  .download__header {
    text-align: center;
    margin-bottom: 50px;
  }
  .download__header .muted {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.7em;
    font-weight: 500;
  }
  .download__header .lead { margin: 16px auto 0; }
  .download__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .dl-card__store {
    display: block;
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  .dl-card__store-ver {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-faint);
  }
  .dl-card__store:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .dl-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }
  .dl-card:hover { border-color: var(--accent); }
  .dl-card__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }
  .dl-card__icon { font-size: 36px; line-height: 1; }
  .dl-card h3 { margin: 0 0 4px; font-size: 1.1rem; }
  .dl-card__note { font-size: 12px; color: var(--text-muted); }
  .dl-card__btn {
    width: 100%;
    justify-content: center;
    margin-bottom: 8px;
  }
  .dl-card__alt {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 8px;
    text-align: center;
  }
  .dl-card__alt:hover { color: var(--accent); }
  .download__notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin: 40px 0 24px;
  }
  .note {
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    padding: 14px 18px;
    border-radius: 0 6px 6px 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .note strong { color: var(--text); }
  .download__all {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
  }

  /* Quick install block */
  .quick-install {
    max-width: 720px;
    margin: 0 auto 28px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 24px;
  }
  .quick-install__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 10px;
  }
  .quick-install__tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
  }
  .download__stores { text-align: center; margin: -24px 0 36px; }
  .download__stores-heading { color: var(--text-faint); font-size: 14px; margin: 0 0 12px; }
  .store-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .store-badge {
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
    min-width: 190px; padding: 10px 16px; border-radius: 12px;
    border: 1px solid var(--border); background: var(--bg-elev, transparent);
    color: var(--text); text-decoration: none;
    transition: border-color .15s ease, transform .15s ease;
  }
  .store-badge:hover { border-color: var(--accent); transform: translateY(-1px); }
  .store-badge__name { font-weight: 600; font-size: 15px; }
  .store-badge__ver { font-weight: 400; color: var(--text-faint); font-size: 13px; }
  .store-badge__note { font-size: 12px; color: var(--text-faint); }
  .download__pm { margin-top: 40px; }
  .download__pm h3 { font-size: 18px; margin: 0 0 14px; }
  .pm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .pm-item { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; min-width: 0; }
  .pm-item__head { font-size: 14px; margin-bottom: 8px; }
  .pm-item__cmd {
    margin: 0; padding: 8px 10px; border-radius: 6px; overflow-x: auto;
    background: var(--code-bg, rgba(127,127,127,.1)); font-size: 12.5px; line-height: 1.5;
  }
  .pm-note { font-size: 13px; color: var(--text-faint); margin: 10px 0 28px; }
  @media (max-width: 520px) { .store-badge { min-width: 0; flex: 1 1 100%; } }
  .pm-item { position: relative; }
  .pm-copy {
    position: absolute; top: 8px; right: 10px;
    padding: 2px 10px; font-size: 11px; border-radius: 5px; cursor: pointer;
    border: 1px solid var(--border); background: transparent; color: var(--text-faint);
  }
  .pm-copy:hover { color: var(--text); border-color: var(--accent); }
  .pm-copy.copied { color: #2ea043; border-color: #2ea043; }
</style>

<script is:inline>
  // Copy buttons on the package-manager commands.
  document.querySelectorAll('.pm-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var code = btn.parentElement.querySelector('code');
      if (!code || !navigator.clipboard) return;
      navigator.clipboard.writeText(code.textContent || '').then(function () {
        var orig = btn.textContent;
        btn.classList.add('copied');
        btn.textContent = '✓';
        setTimeout(function () { btn.classList.remove('copied'); btn.textContent = orig; }, 1500);
      });
    });
  });
</script>
