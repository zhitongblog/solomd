---
import { getT, type Lang } from '../i18n/translations';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = getT(lang);
// One list for the site, the README and the in-app About dialog.
import { sponsors as sponsorList, promoters, featuredPromoters, testers, contributors, communityReporters } from '../lib/supporters';
const sponsors: string[] = sponsorList.map((x) => x.name);
const promoteHref = lang === 'zh' ? '/zh/promote' : '/promote';
const thanksHref = lang === 'zh' ? '/zh/thanks/' : '/thanks/';

// TODO: replace with real GitHub Sponsors URL once approved
const githubSponsorUrl = 'https://github.com/sponsors/zhitongblog';
const paypalUrl = 'https://paypal.me/solomdapp';

// QR images live in /public/sponsor/.
const alipayQr = '/sponsor/alipay-qr.jpg';
const wechatQr = '/sponsor/wechat-qr.jpg';

interface InAppCopy {
  badgeLabel: string;
  heading: string;
  desc: string;
  tiers: { icon: string; name: string; price: string }[];
  footnote: string;
}

