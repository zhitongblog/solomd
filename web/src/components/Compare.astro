---
import { getT, type Lang } from '../i18n/translations';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = getT(lang);

// /compare/ sub-pages exist only in en + zh; other locales link to en.
const compareIndex = lang === 'zh' ? '/zh/compare/' : '/compare/';
const moreLabel = {
  en: 'See each editor side-by-side →',
  zh: '看每款逐项对比 →',
  ja: 'エディタごとに横並び比較 →',
  ko: '에디터별로 나란히 비교 →',
  de: 'Jeden Editor nebeneinander sehen →',
  fr: 'Voir chaque éditeur côte à côte →',
  es: 'Ver cada editor lado a lado →',
  pt: 'Ver cada editor lado a lado →',
  it: 'Vedi ogni editor a confronto →',
  pl: 'Zobacz każdy edytor obok siebie →',
  nl: 'Zie elke editor naast elkaar →',
  tr: 'Her editörü yan yana görün →',
  sv: 'Se varje editor sida vid sida →',
  uk: 'Подивитися кожен редактор поруч →',
}[lang];

const winsAll: Record<Lang, { icon: 'export' | 'sync' | 'ai'; title: string; desc: string }[]> = {
  en: [
    { icon: 'export', title: 'Built-in 9-format export', desc: 'Export PDF, Word (.docx), EPUB, HTML & LaTeX out of the box with live preview — unlike Typora or Obsidian, zero external Pandoc install needed.' },
    { icon: 'sync', title: 'Free 5-platform vault sync', desc: 'Sync across macOS, Windows, Linux, iOS & Android via iCloud, OneDrive, WebDAV, S3, or Git with E2EE — no $96/yr Obsidian Sync subscription.' },
    { icon: 'ai', title: 'Zero-config local AI & 16-tool MCP', desc: 'OPR auto-detects local Ollama / LM Studio, plus 20+ BYOK providers, local semantic RAG search, and a bundled 16-tool MCP server.' },
  ],
  zh: [
    { icon: 'export', title: '内置 9 格式直出导出', desc: '开箱直出 PDF、Word (.docx)、EPUB、HTML 与 LaTeX 并带实时预览 —— 无需像 Typora 那样手动折腾安装 Pandoc。' },
    { icon: 'sync', title: '五端免费加密知识库同步', desc: '支持 Mac、Win、Linux、iOS 与 Android 通过 iCloud、OneDrive、坚果云、WebDAV、S3 或 Git 端到端加密同步 —— 省下 $96/年的同步订阅费。' },
    { icon: 'ai', title: '零配置本地 AI 与 16 工具 MCP', desc: 'OPR 自动发现本机 Ollama / LM Studio，支持 20+ 家 BYOK 服务商、本地离线语义搜索与 16 工具 MCP 服务。' },
  ],
  ja: [
    { icon: 'export', title: '9形式の内蔵ダイレクト出力', desc: 'PDF・Word (.docx)・EPUB・HTML・LaTeX を標準出力。Typora や Obsidian のように外部 Pandoc を導入する必要はありません。' },
    { icon: 'sync', title: '5プラットフォーム無料の暗号化同期', desc: 'macOS・Windows・Linux・iOS・Android を iCloud / OneDrive / WebDAV / S3 / Git で E2EE 同期。月額課金なし。' },
    { icon: 'ai', title: 'ローカル AI 自動検出 & 16ツール MCP', desc: 'OPR でローカル Ollama / LM Studio を自動検出し、20+ の BYOK、ローカル RAG 検索、16ツールの MCP サーバーを内蔵。' },
  ],
  ko: [
    { icon: 'export', title: '9가지 형식 기본 내보내기', desc: 'PDF, Word(.docx), EPUB, HTML, LaTeX를 별도 Pandoc 설치 없이 바로 내보냅니다.' },
    { icon: 'sync', title: '5개 플랫폼 무료 암호화 동기화', desc: 'iCloud, OneDrive, WebDAV, S3, Git 기반 종단간 암호화 동기화 — 연 $96 구독료가 필요 없습니다.' },
    { icon: 'ai', title: '로컬 AI 자동 감지 & 16개 도구 MCP', desc: 'Ollama / LM Studio 자동 감지, 20+ BYOK 모델, 로컬 시맨틱 RAG 검색 및 16개 도구 MCP 서버 내장.' },
  ],
  de: [
    { icon: 'export', title: '9 Formate direkt integriert', desc: 'PDF, Word (.docx), EPUB, HTML & LaTeX direkt exportieren — ohne externes Pandoc-Setup wie bei Typora oder Obsidian.' },
    { icon: 'sync', title: 'Kostenloser 5-Plattform-Sync', desc: 'E2EE-Sync über macOS, Windows, Linux, iOS & Android via iCloud, OneDrive, WebDAV, S3 oder Git — ohne 96 $/Jahr Abo.' },
    { icon: 'ai', title: 'Lokale KI & 16-Tool-MCP-Server', desc: 'OPR erkennt Ollama / LM Studio automatisch, plus 20+ BYOK-Anbieter, lokales RAG und gebündelter 16-Tool-MCP-Server.' },
  ],
  fr: [
    { icon: 'export', title: 'Export intégré en 9 formats', desc: 'Exportez en PDF, Word (.docx), EPUB, HTML et LaTeX sans installer Pandoc séparément.' },
    { icon: 'sync', title: 'Sync chiffrée gratuite sur 5 plateformes', desc: 'Synchronisez macOS, Windows, Linux, iOS et Android via iCloud, OneDrive, WebDAV, S3 ou Git sans abonnement.' },
    { icon: 'ai', title: 'IA locale & serveur MCP 16 outils', desc: 'Détection auto d’Ollama / LM Studio, 20+ fournisseurs BYOK, recherche RAG locale et serveur MCP 16 outils inclus.' },
  ],
  es: [
    { icon: 'export', title: 'Exportación integrada en 9 formatos', desc: 'Exporta a PDF, Word (.docx), EPUB, HTML y LaTeX sin instalar Pandoc por separado.' },
    { icon: 'sync', title: 'Sincronización cifrada gratis en 5 plataformas', desc: 'Sincroniza macOS, Windows, Linux, iOS y Android con iCloud, OneDrive, WebDAV, S3 o Git sin suscripciones.' },
    { icon: 'ai', title: 'IA local sin configuración y MCP de 16 herramientas', desc: 'Detecta Ollama / LM Studio automáticamente, más 20+ proveedores BYOK, búsqueda RAG local y servidor MCP integrado.' },
  ],
  pt: [
    { icon: 'export', title: 'Exportação integrada em 9 formatos', desc: 'Exporte PDF, Word (.docx), EPUB, HTML e LaTeX direto do app — sem precisar instalar Pandoc.' },
    { icon: 'sync', title: 'Sync criptografado grátis em 5 plataformas', desc: 'Sincronize macOS, Windows, Linux, iOS e Android via iCloud, OneDrive, WebDAV, S3 ou Git sem assinatura.' },
    { icon: 'ai', title: 'IA local & servidor MCP com 16 ferramentas', desc: 'Detecção automática de Ollama / LM Studio, 20+ provedores BYOK, busca RAG local e servidor MCP embutido.' },
  ],
  it: [
    { icon: 'export', title: 'Esportazione integrata in 9 formati', desc: 'Esporta in PDF, Word (.docx), EPUB, HTML e LaTeX subito, senza installare Pandoc.' },
    { icon: 'sync', title: 'Sync cifrato gratuito su 5 piattaforme', desc: 'Sincronizza macOS, Windows, Linux, iOS e Android via iCloud, OneDrive, WebDAV, S3 o Git senza abbonamento.' },
    { icon: 'ai', title: 'AI locale & server MCP a 16 strumenti', desc: 'Rilevamento automatico di Ollama / LM Studio, 20+ provider BYOK, ricerca RAG locale e server MCP integrato.' },
  ],
  pl: [
    { icon: 'export', title: 'Wbudowany eksport do 9 formatów', desc: 'Eksportuj PDF, Word (.docx), EPUB, HTML i LaTeX od ręki — bez ręcznej instalacji Pandoc.' },
    { icon: 'sync', title: 'Darmowa szyfrowana synchronizacja (5 platform)', desc: 'Synchronizuj macOS, Windows, Linux, iOS i Android przez iCloud, OneDrive, WebDAV, S3 lub Git bez abonamentu.' },
    { icon: 'ai', title: 'Lokalne AI i serwer MCP (16 narzędzi)', desc: 'Automatyczne wykrywanie Ollama / LM Studio, 20+ dostawców BYOK, lokalne RAG i wbudowany serwer MCP.' },
  ],
  nl: [
    { icon: 'export', title: 'Ingebouwde export naar 9 formaten', desc: 'Exporteer direct naar PDF, Word (.docx), EPUB, HTML en LaTeX zonder Pandoc te installeren.' },
    { icon: 'sync', title: 'Gratis versleutelde sync op 5 platforms', desc: 'Synchroniseer macOS, Windows, Linux, iOS en Android via iCloud, OneDrive, WebDAV, S3 of Git zonder abonnement.' },
    { icon: 'ai', title: 'Lokale AI & 16-tool MCP-server', desc: 'Automatische detectie van Ollama / LM Studio, 20+ BYOK-providers, lokaal RAG en ingebouwde MCP-server.' },
  ],
  tr: [
    { icon: 'export', title: 'Yerleşik 9 format dışa aktarma', desc: 'Harici Pandoc kurmadan PDF, Word (.docx), EPUB, HTML ve LaTeX olarak doğrudan dışa aktarın.' },
    { icon: 'sync', title: '5 platformda ücretsiz şifreli eşitleme', desc: 'iCloud, OneDrive, WebDAV, S3 veya Git ile aboneliksiz uçtan uca şifreli eşitleme.' },
    { icon: 'ai', title: 'Sıfır ayar yerel AI ve 16 araçlı MCP', desc: 'Ollama / LM Studio otomatik algılama, 20+ BYOK sağlayıcı, yerel RAG arama ve yerleşik MCP sunucusu.' },
  ],
  sv: [
    { icon: 'export', title: 'Inbyggd export till 9 format', desc: 'Exportera PDF, Word (.docx), EPUB, HTML och LaTeX direkt — utan separat Pandoc-installation.' },
    { icon: 'sync', title: 'Gratis krypterad synk på 5 plattformar', desc: 'Synka macOS, Windows, Linux, iOS och Android via iCloud, OneDrive, WebDAV, S3 eller Git utan prenumeration.' },
    { icon: 'ai', title: 'Lokal AI & 16-verktygs MCP-server', desc: 'Automatisk identifiering av Ollama / LM Studio, 20+ BYOK-leverantörer, lokal RAG och inbyggd MCP-server.' },
  ],
  uk: [
    { icon: 'export', title: 'Вбудований експорт у 9 форматів', desc: 'Експортуйте PDF, Word (.docx), EPUB, HTML і LaTeX одразу — без ручного встановлення Pandoc.' },
    { icon: 'sync', title: 'Безкоштовна шифрована синхронізація (5 платформ)', desc: 'Синхронізуйте macOS, Windows, Linux, iOS та Android через iCloud, OneDrive, WebDAV, S3 або Git без підписки.' },
    { icon: 'ai', title: 'Локальний ШІ та MCP-сервер (16 інструментів)', desc: 'Автовиявлення Ollama / LM Studio, 20+ провайдерів BYOK, локальний RAG-пошук і вбудований MCP-сервер.' },
  ],
};
const wins = winsAll[lang];
---

<section id="compare">
  <div class="container">
    <div class="compare__header">
      <h2>{tr.compare.heading}</h2>
      <p class="lead">{tr.compare.lead}</p>
    </div>

    <div class="compare__wins">
      {wins.map((w) => (
        <div class="compare__win">
          <div class="compare__win-icon" aria-hidden="true">
            {w.icon === 'export' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3-3 3 3"/></svg>
            )}
            {w.icon === 'sync' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/><path d="M12 13v4"/><path d="m10 15 2-2 2 2"/></svg>
            )}
            {w.icon === 'ai' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
            )}
          </div>
          <h3>{w.title}</h3>
          <p>{w.desc}</p>
        </div>
      ))}
    </div>

    <div class="compare__table-wrap">
      <table class="compare__table">
        <thead>
          <tr>
            <th></th>
            <th class="compare__highlight">{tr.compare.headers.solomd}</th>
            <th>{tr.compare.headers.typora}</th>
            <th>{tr.compare.headers.marktext}</th>
            <th>{tr.compare.headers.obsidian}</th>
          </tr>
        </thead>
        <tbody>
          {tr.compare.rows.map((row) => (
            <tr>
              <th scope="row">{row[0]}</th>
              <td class="compare__highlight">{row[1]}</td>
              <td>{row[2]}</td>
              <td>{row[3]}</td>
              <td>{row[4]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="compare__more">
      <a href={compareIndex}>{moreLabel}</a>
    </div>
  </div>
</section>

<style>
  .compare__header {
    text-align: center;
    margin-bottom: 36px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .compare__header .lead { margin: 14px auto 0; }

  .compare__wins {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin: 0 0 40px;
  }
  .compare__win {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 24px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .compare__win:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -14px rgba(31, 30, 28, 0.16);
  }
  .compare__win-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .compare__win h3 {
    font-size: 1.02rem;
    margin: 0 0 8px;
  }
  .compare__win p {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .compare__table-wrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 4px 20px -10px rgba(31, 30, 28, 0.08);
  }
  .compare__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-elev);
    font-size: 14px;
    min-width: 640px;
  }
  .compare__table thead th {
    background: var(--bg-soft);
    padding: 15px 16px;
    text-align: center;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }
  .compare__table tbody tr:hover {
    background: color-mix(in srgb, var(--bg-soft) 55%, transparent);
  }
  .compare__table tbody th {
    text-align: left;
    padding: 13px 18px;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
  }
  .compare__table tbody td {
    text-align: center;
    padding: 13px 16px;
    color: var(--text);
    border-bottom: 1px solid var(--hairline);
  }
  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: none;
  }
  .compare__highlight {
    background: var(--accent-soft) !important;
    color: var(--text) !important;
    font-weight: 600;
  }

  .compare__more {
    text-align: center;
    margin-top: 24px;
  }
  .compare__more a {
    color: var(--accent-deep);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .compare__more a:hover { text-decoration: underline; }
</style>
