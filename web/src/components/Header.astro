---
import { getT, LANGS, type Lang } from '../i18n/translations';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = getT(lang);

const langPrefix = lang === 'en' ? '' : `/${lang}`;
const homeHref = langPrefix + '/';
// Sub-pages currently exist only in en + zh. Other locales fall back to en.
const subPrefix = lang === 'zh' ? '/zh' : '';
const NAV = {
  en: { whatsNew: 'What’s New', more: 'More', agents: 'Agents & MCP', sync: 'Cloud Sync', compare: 'Compare', docs: 'Docs', blog: 'Blog', contact: 'Contact', sponsor: 'Sponsor', supportTitle: 'Support the developer', menuLabel: 'Toggle menu' },
  zh: { whatsNew: '更新日志', more: '更多', agents: 'AI 与 Agent', sync: '五端同步', compare: '竞品对比', docs: '使用文档', blog: '博客', contact: '联系我们', sponsor: '赞助支持', supportTitle: '支持开发者', menuLabel: '切换导航菜单' },
  ja: { whatsNew: '新機能', more: 'その他', agents: 'Agents', sync: '同期', compare: '比較', docs: 'ドキュメント', blog: 'ブログ', contact: 'お問い合わせ', sponsor: 'スポンサー', supportTitle: '開発者をサポート', menuLabel: 'メニュー' },
  ko: { whatsNew: '새소식', more: '더보기', agents: 'Agents', sync: '동기화', compare: '비교', docs: '문서', blog: '블로그', contact: '문의', sponsor: '후원', supportTitle: '개발자 후원', menuLabel: '메뉴' },
  de: { whatsNew: 'Neu', more: 'Mehr', agents: 'Agents', sync: 'Sync', compare: 'Vergleich', docs: 'Docs', blog: 'Blog', contact: 'Kontakt', sponsor: 'Sponsor', supportTitle: 'Entwickler unterstützen', menuLabel: 'Menü' },
  fr: { whatsNew: 'Nouveautés', more: 'Plus', agents: 'Agents', sync: 'Sync', compare: 'Comparer', docs: 'Docs', blog: 'Blog', contact: 'Contact', sponsor: 'Sponsor', supportTitle: 'Soutenir le développeur', menuLabel: 'Menu' },
  es: { whatsNew: 'Novedades', more: 'Más', agents: 'Agentes', sync: 'Sync', compare: 'Comparar', docs: 'Docs', blog: 'Blog', contact: 'Contacto', sponsor: 'Patrocinar', supportTitle: 'Apoyar al desarrollador', menuLabel: 'Menú' },
  pt: { whatsNew: 'Novidades', more: 'Mais', agents: 'Agentes', sync: 'Sync', compare: 'Comparar', docs: 'Docs', blog: 'Blog', contact: 'Contato', sponsor: 'Patrocinar', supportTitle: 'Apoiar o desenvolvedor', menuLabel: 'Menu' },
  it: { whatsNew: 'Novità', more: 'Altro', agents: 'Agent', sync: 'Sync', compare: 'Confronto', docs: 'Docs', blog: 'Blog', contact: 'Contatto', sponsor: 'Sponsor', supportTitle: 'Supporta lo sviluppatore', menuLabel: 'Menu' },
  pl: { whatsNew: 'Nowości', more: 'Więcej', agents: 'Agent', sync: 'Sync', compare: 'Porównanie', docs: 'Dokumenty', blog: 'Blog', contact: 'Kontakt', sponsor: 'Wesprzyj', supportTitle: 'Wesprzyj dewelopera', menuLabel: 'Menu' },
  nl: { whatsNew: 'Nieuw', more: 'Meer', agents: 'Agents', sync: 'Sync', compare: 'Vergelijken', docs: 'Docs', blog: 'Blog', contact: 'Contact', sponsor: 'Sponsor', supportTitle: 'Steun de ontwikkelaar', menuLabel: 'Menu' },
  tr: { whatsNew: 'Yenilikler', more: 'Diğer', agents: 'Ajan', sync: 'Sync', compare: 'Karşılaştır', docs: 'Dokümanlar', blog: 'Blog', contact: 'İletişim', sponsor: 'Destek Ol', supportTitle: 'Geliştiriciyi destekle', menuLabel: 'Menü' },
  sv: { whatsNew: 'Nyheter', more: 'Mer', agents: 'Agents', sync: 'Sync', compare: 'Jämför', docs: 'Docs', blog: 'Blog', contact: 'Kontakt', sponsor: 'Stöd', supportTitle: 'Stöd utvecklaren', menuLabel: 'Meny' },
  uk: { whatsNew: 'Нове', more: 'Ще', agents: 'Агент', sync: 'Sync', compare: 'Порівняння', docs: 'Документи', blog: 'Блог', contact: 'Контакт', sponsor: 'Підтримати', supportTitle: 'Підтримати розробника', menuLabel: 'Меню' },
}[lang];

const TOPBAR = {
  en: 'Become an AI-era PM — words → product',
  zh: '言出法随一句话，AI 就给你做出来',
  ja: 'AI 時代の PM になる — 一言で AI がプロダクトを作る',
  ko: 'AI 시대의 PM 되기 — 말 한마디로 AI가 제품을 만든다',
  de: 'Werde PM im AI-Zeitalter — sprich, und AI baut es',
  fr: 'Devenez PM à l\'ère de l\'IA — parlez, l\'IA construit',
  es: 'Conviértete en PM de la era IA — habla, la IA lo construye',
  pt: 'Torne-se PM da era IA — fale, a IA constrói',
  it: 'Diventa PM nell\'era AI — parla, l\'AI lo costruisce',
  pl: 'Zostań PM-em ery AI — mów, AI buduje',
  nl: 'Word PM in het AI-tijdperk — spreek, AI bouwt',
  tr: 'AI çağının PM\'i ol — söyle, AI inşa etsin',
  sv: 'Bli PM i AI-eran — säg det, AI bygger det',
  uk: 'Стань PM-ом ери AI — скажи, AI побудує',
}[lang];
---

<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__text">
      ✨ {TOPBAR} →
      <a href="https://doaipm.com" target="_blank" rel="noopener">doAIPM.com</a>
    </span>
  </div>
</div>
<header class="header">
  <div class="container header__inner">
    <a href={homeHref} class="header__brand">
      <img class="header__mark" src="/favicon.svg?v=4.11.4" alt="" width="28" height="28" />
      <span class="header__name">SoloMD</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <a href={homeHref + '#features'}>{tr.nav.features}</a>
      <a href={subPrefix + '/compare/'}>{NAV.compare}</a>
      <a href={subPrefix + '/docs/'}>{NAV.docs}</a>
      <a href={langPrefix + '/whats-new/'} class="header__nav-new">
        {NAV.whatsNew} <sup>v5.4.4</sup>
      </a>

      <div class="header__dropdown" data-dropdown="more">
        <button type="button" class="header__dropdown-btn" aria-haspopup="true" aria-expanded="false">
          {NAV.more} <span class="header__caret" aria-hidden="true">▾</span>
        </button>
        <div class="header__menu" role="menu">
          <a href={subPrefix + '/promote'} role="menuitem" class="header__menu-promote">
            ✨ {lang === 'zh' ? '推广者计划' : 'Promoter Program'}
          </a>
          <a href={subPrefix + '/agents/'} role="menuitem">{NAV.agents}</a>
          <a href={subPrefix + '/sync/'} role="menuitem">{NAV.sync}</a>
          <a href={subPrefix + '/blog/'} role="menuitem">{NAV.blog}</a>
          <a href={homeHref + '#contact'} role="menuitem">{NAV.contact}</a>
          <a href={homeHref + '#sponsor'} role="menuitem" class="header__menu-sponsor">
            <span class="header__sponsor-heart">♥</span> {NAV.sponsor}
          </a>
        </div>
      </div>
    </nav>

    <div class="header__actions">
      <a
        href="https://github.com/zhitongblog/solomd"
        class="header__gh"
        target="_blank"
        rel="noopener"
        data-star-cta="header"
      >
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="header__stars" data-stars></span>
      </a>

      <a href={homeHref + '#sponsor'} class="header__sponsor" title={NAV.supportTitle} aria-label={NAV.supportTitle}>
        <span class="header__sponsor-heart">♥</span>
        <span class="header__sponsor-label">{NAV.sponsor}</span>
      </a>

      <a href={homeHref + '#download'} class="header__download">{tr.nav.download}</a>

      <div class="header__dropdown header__lang-wrap" data-dropdown="lang">
        <button type="button" class="header__lang" aria-haspopup="true" aria-expanded="false">
          {tr.langSwitch} ▾
        </button>
        <div class="header__menu header__lang-menu" role="menu">
          {LANGS.map((L) => (
            <a href={L.href} role="menuitem" class={L.code === lang ? 'is-active' : ''}>{L.label}</a>
          ))}
        </div>
      </div>

      <button type="button" class="header__burger" aria-label={NAV.menuLabel} aria-expanded="false" aria-controls="mobile-drawer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" class="mobile-drawer" hidden>
    <div class="container mobile-drawer__inner">
      <a href={homeHref + '#features'}>{tr.nav.features}</a>
      <a href={subPrefix + '/compare/'}>{NAV.compare}</a>
      <a href={subPrefix + '/docs/'}>{NAV.docs}</a>
      <a href={langPrefix + '/whats-new/'}>{NAV.whatsNew} <sup class="mobile-drawer__sup">v5.4.4</sup></a>
      <a href={subPrefix + '/promote'}>✨ {lang === 'zh' ? '推广者计划' : 'Promoter Program'}</a>
      <a href={subPrefix + '/agents/'}>{NAV.agents}</a>
      <a href={subPrefix + '/sync/'}>{NAV.sync}</a>
      <a href={subPrefix + '/blog/'}>{NAV.blog}</a>
      <a href={homeHref + '#contact'}>{NAV.contact}</a>
      <a href="https://github.com/zhitongblog/solomd" target="_blank" rel="noopener">GitHub <span data-stars></span></a>
    </div>
  </div>
</header>

<script is:inline>
  // Live GitHub star count for every [data-stars] on the page.
  (function () {
    var els = document.querySelectorAll('[data-stars]');
    if (!els.length) return;
    fetch('/api/stats')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (s) {
        if (!s || typeof s.stars !== 'number' || s.stars <= 0) return;
        var txt = '⭐ ' + (s.stars >= 1000 ? (s.stars / 1000).toFixed(1) + 'k' : s.stars);
        els.forEach(function (el) { el.textContent = txt; });
      })
      .catch(function () {});
  })();
</script>
<script is:inline>
  (function () {
    var dropdowns = Array.prototype.slice.call(document.querySelectorAll('[data-dropdown]'));
    var burger = document.querySelector('.header__burger');
    var drawer = document.getElementById('mobile-drawer');

    function closeAll(except) {
      dropdowns.forEach(function (dd) {
        if (dd === except) return;
        var m = dd.querySelector('.header__menu');
        var b = dd.querySelector('button');
        if (m) m.classList.remove('is-open');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (burger && drawer && burger.contains(t)) {
        var open = drawer.hidden;
        drawer.hidden = !open;
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        closeAll(null);
        return;
      }
      var matched = null;
      for (var i = 0; i < dropdowns.length; i++) {
        var dd = dropdowns[i];
        var btn = dd.querySelector('button');
        var menu = dd.querySelector('.header__menu');
        if (btn && btn.contains(t)) {
          matched = dd;
          var next = menu.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', next ? 'true' : 'false');
          break;
        }
        if (menu && menu.contains(t)) {
          matched = dd;
          break;
        }
      }
      closeAll(matched);
      if (drawer && !drawer.hidden && (!drawer.contains(t) || t.closest('a'))) {
        drawer.hidden = true;
        if (burger) burger.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>

<style>
  .topbar {
    background: #181715;
    color: #ffffff;
    font-size: 12px;
    text-align: center;
    padding: 6px 0;
  }
  .topbar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .topbar__text {
    color: rgba(255, 255, 255, 0.82);
  }
  .topbar__text a {
    color: #f0965a;
    font-weight: 600;
    text-decoration: none;
  }
  .topbar__text a:hover {
    text-decoration: underline;
  }
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--hairline);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .header__brand:hover { text-decoration: none; }
  .header__mark {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    box-shadow: 0 3px 10px rgba(224, 123, 57, 0.22);
  }
  .header__name { font-weight: 700; letter-spacing: -0.02em; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .header__nav > a,
  .header__dropdown-btn {
    white-space: nowrap;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    border: 0;
    padding: 4px 2px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s;
  }
  .header__nav > a:hover,
  .header__dropdown-btn:hover {
    color: var(--text);
    text-decoration: none;
  }
  .header__caret { font-size: 11px; opacity: 0.7; }
  .header__nav-new {
    color: var(--text) !important;
    font-weight: 600 !important;
  }
  .header__nav-new sup,
  .mobile-drawer__sup {
    font-size: 9.5px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    padding: 2px 6px;
    border-radius: 999px;
    margin-left: 3px;
    font-weight: 700;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .header__gh {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .header__gh:hover {
    color: var(--text);
    border-color: var(--ink-soft);
    background: var(--fill-1);
    text-decoration: none;
  }
  .header__stars {
    font-variant-numeric: tabular-nums;
  }
  .header__stars:empty { display: none; }

  .header__sponsor {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12.5px;
    color: var(--accent-deep);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .header__sponsor:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border-color: var(--accent);
    text-decoration: none;
  }
  .header__sponsor-heart {
    color: #e11d48;
    font-size: 12px;
    line-height: 1;
  }

  .header__download {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, transform 0.15s;
  }
  .header__download:hover {
    background: var(--ink-soft);
    color: var(--bg);
    text-decoration: none;
  }

  .header__dropdown { position: relative; }
  .header__lang {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 12px;
    color: var(--text-muted);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }
  .header__lang:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .header__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 156px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 6px;
    display: none;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 14px 36px -8px rgba(0, 0, 0, 0.18);
    z-index: 60;
  }
  .header__menu.is-open { display: flex; }
  .header__menu a {
    padding: 7px 12px;
    border-radius: 7px;
    font-size: 13px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .header__menu a:hover {
    background: var(--bg-soft);
    color: var(--accent-deep);
    text-decoration: none;
  }
  .header__menu a.is-active {
    color: var(--accent-deep);
    font-weight: 600;
    background: var(--accent-soft);
  }
  .header__menu-sponsor {
    border-top: 1px solid var(--hairline);
    margin-top: 4px;
    padding-top: 9px !important;
  }

  .header__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    padding: 0;
  }
  .mobile-drawer {
    border-top: 1px solid var(--hairline);
    background: var(--bg);
    padding: 12px 0 18px;
  }
  .mobile-drawer__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 12px;
  }
  .mobile-drawer__inner a {
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    background: var(--bg-soft);
  }
  .mobile-drawer__inner a:hover {
    color: var(--accent-deep);
  }

  @media (max-width: 1020px) {
    .header__gh { display: none; }
    .header__nav { gap: 16px; }
  }
  @media (max-width: 860px) {
    .header__nav { display: none; }
    .header__burger { display: inline-flex; }
    .header__sponsor-label { display: none; }
    .header__sponsor { padding: 5px 9px; }
  }
  @media (max-width: 400px) {
    .header__inner { gap: 8px; }
    .header__actions { gap: 6px; }
    .header__download { padding: 5px 11px; font-size: 12px; }
    .header__sponsor { display: none; }
  }
</style>
