---
import { getT, type Lang } from '../i18n/translations';
import { fetchGithubDownloads } from '../lib/download-channels';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = getT(lang);

const VERSION = '4.14.11';
const REPO = 'zhitongblog/solomd';
const baseUrl = `https://github.com/${REPO}/releases/download/v${VERSION}`;
const GITHUB_URL = `https://github.com/${REPO}`;
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const whatsNewHref = `${langPrefix}/whats-new/`;
// /agents/ sub-page exists only in en + zh; ja/ko link to en.
const agentsHref = lang === 'zh' ? '/zh/agents/' : '/agents/';
// The banner above the hero invites people into the promoter program
// (/promote). It replaced the v4.11.3 new-logo announcement.
const promoteHref = lang === 'zh' ? '/zh/promote' : '/promote';
const PROMOTE_BANNER = {
  en: { eyebrow: 'PROMOTER PROGRAM', title: 'Tell people about SoloMD — your name goes in it.', cta: 'How it works' },
  zh: { eyebrow: '推广者计划', title: '帮 SoloMD 说句话，你的名字就会写进它里面。', cta: '看看怎么参与' },
  ja: { eyebrow: 'プロモーター・プログラム', title: 'SoloMD を紹介すると、あなたの名前が刻まれます。', cta: '参加方法を見る' },
  ko: { eyebrow: '프로모터 프로그램', title: 'SoloMD를 알려 주세요 — 이름이 함께 실립니다.', cta: '참여 방법 보기' },
  de: { eyebrow: 'PROMOTER-PROGRAMM', title: 'Erzähl von SoloMD — und dein Name steht drin.', cta: 'So funktioniert es' },
  fr: { eyebrow: 'PROGRAMME AMBASSADEURS', title: 'Parlez de SoloMD — votre nom y figurera.', cta: 'Comment ça marche' },
  es: { eyebrow: 'PROGRAMA DE DIFUSIÓN', title: 'Habla de SoloMD y tu nombre quedará en él.', cta: 'Cómo funciona' },
  pt: { eyebrow: 'PROGRAMA DE DIVULGAÇÃO', title: 'Fale do SoloMD e seu nome fica nele.', cta: 'Como funciona' },
  it: { eyebrow: 'PROGRAMMA PROMOTORI', title: 'Parla di SoloMD: il tuo nome ci resterà.', cta: 'Come funziona' },
  pl: { eyebrow: 'PROGRAM PROMOTORÓW', title: 'Opowiedz o SoloMD — Twoje imię w nim zostanie.', cta: 'Jak to działa' },
  nl: { eyebrow: 'PROMOTERPROGRAMMA', title: 'Vertel over SoloMD — je naam komt erin.', cta: 'Zo werkt het' },
  tr: { eyebrow: 'TANITIM PROGRAMI', title: "SoloMD'yi anlat, adın onda yer alsın.", cta: 'Nasıl çalışır' },
  sv: { eyebrow: 'PROMOTORPROGRAM', title: 'Berätta om SoloMD — ditt namn hamnar i den.', cta: 'Så funkar det' },
  uk: { eyebrow: 'ПРОГРАМА ПРОМОУТЕРІВ', title: 'Розкажіть про SoloMD — і ваше ім’я буде в ньому.', cta: 'Як це працює' },
}[lang];
const ONE_LINE_LABEL = {
  en: 'Or one-line install',
  zh: '或一键安装命令',
  ja: 'またはワンラインインストール',
  ko: '또는 한 줄 설치',
  de: 'Oder Ein-Zeilen-Installation',
  fr: 'Ou installation en une ligne',
  es: 'O instalación en una línea',
  pt: 'Ou instalação em uma linha',
  it: 'O installazione in una riga',
  pl: 'Lub instalacja w jednej linii',
  nl: 'Of installatie in één regel',
  tr: 'Veya tek satırlık kurulum',
  sv: 'Eller enradsinstallation',
  uk: 'Або встановлення одним рядком',
}[lang];

// Default (SSR / no-JS / unknown OS) → mac dmg link
const defaultDownload = `${baseUrl}/SoloMD_${VERSION}_universal.dmg`;

// ---- Fetch stats at BUILD time (Cloudflare Pages runs this fresh) ----
// This guarantees the numbers render even if the client-side API call
// gets rate-limited. Client-side JS can still update to a newer value.
//
// Auth header (when GITHUB_TOKEN env is present) bumps the rate limit
// from 60/hr (anon, per IP) to 5000/hr (authed). Without it, multiple
// builds in the same hour can exhaust the limit and cause empty
// downloads to be SSR'd into the static HTML — bug seen 2026-05-04.
let initialStars = 0;
let initialDownloads = 0;
const GH_TOKEN = (typeof process !== 'undefined' && process.env && process.env.GITHUB_TOKEN) || '';
const GH_HEADERS: Record<string, string> = {
  'User-Agent': 'SoloMD-build-stats',
  Accept: 'application/vnd.github+json',
};
if (GH_TOKEN) GH_HEADERS.Authorization = `Bearer ${GH_TOKEN}`;
// The all-channel total (GitHub + App Store + Microsoft Store + Play) lives
// behind the production /api/stats, which reads the store numbers from D1.
// Fall back to GitHub alone if the live endpoint can't be reached at build.
try {
  const live = await fetch('https://solomd.app/api/stats', { headers: { 'User-Agent': 'SoloMD-build-stats' } });
  if (live.ok) {
    const j = (await live.json()) as { stars?: number | null; downloads?: number | null };
    if (typeof j.stars === 'number') initialStars = j.stars;
    if (typeof j.downloads === 'number') initialDownloads = j.downloads;
  }
} catch {
  /* fall through to GitHub */
}
if (!initialDownloads || !initialStars) {
  try {
    const gh = await fetchGithubDownloads(REPO, GH_HEADERS);
    if (gh) {
      if (!initialStars && gh.stars) initialStars = gh.stars;
      if (!initialDownloads) initialDownloads = gh.installers;
    }
  } catch {
    // Build will just render empty badges; JS will try to fill them.
  }
}

// "74.8k downloads" used to be English on every locale; CJK readers count in 万.
const DL_WORD: Record<string, string> = {
  en: 'downloads', zh: '次下载', ja: 'ダウンロード', ko: '다운로드', de: 'Downloads', fr: 'téléchargements',
  es: 'descargas', pt: 'downloads', it: 'download', pl: 'pobrań', nl: 'downloads', tr: 'indirme',
  sv: 'nedladdningar', ru: 'загрузок', uk: 'завантажень',
};
const dlWord = DL_WORD[lang] ?? 'downloads';
const dlWan = lang === 'zh' || lang === 'ja' ? '万' : lang === 'ko' ? '만' : '';

function fmtStars(n: number): string {
  return n >= 1000 ? `⭐ ${(n / 1000).toFixed(1)}k` : `⭐ ${n}`;
}
/** Same rule as the inline script below: 7.5万次下载 / 7.5만 다운로드 / 74.8k downloads. */
function fmtDownloads(n: number): string {
  if (dlWan && n >= 10000) return `${(n / 10000).toFixed(1)}${dlWan}${dlWan === '만' ? ' ' : ''}${dlWord}`;
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k ${dlWord}` : `${n} ${dlWord}`;
}
const initialStarsText = initialStars > 0 ? fmtStars(initialStars) : '';
const initialDownloadsText = initialDownloads > 0 ? fmtDownloads(initialDownloads) : '';
---

<a class="brand-update-banner" href={promoteHref}>
  <img class="brand-update-banner__mark" src="/favicon.svg?v=4.11.4" alt="" width="46" height="46" />
  <span class="brand-update-banner__copy">
    <span class="brand-update-banner__eyebrow">{PROMOTE_BANNER.eyebrow}</span>
    <span class="brand-update-banner__title">{PROMOTE_BANNER.title}</span>
  </span>
  <span class="brand-update-banner__cta">{PROMOTE_BANNER.cta} <span aria-hidden="true">→</span></span>
</a>


<section class="hero">
  <div class="container hero__inner">
    <div class="hero__badge">{tr.hero.badge} · <span id="hero-stars">{initialStarsText}</span> · <span id="hero-dl-count" data-word={dlWord} data-wan={dlWan}>{initialDownloadsText}</span></div>
    <h1>
      {tr.hero.title1}<br />
      <span class="hero__accent">{tr.hero.title2}</span>
    </h1>
    <p class="hero__subtagline">{tr.hero.subtagline}</p>
    <div class="hero__cta">
      <a
        id="hero-download"
        href={defaultDownload}
        class="btn btn--primary btn--lg"
        data-default-text={tr.hero.ctaPrimary}
        data-mac-text={tr.hero.ctaForMac}
        data-win-text={tr.hero.ctaForWindows}
        data-linux-text={tr.hero.ctaForLinux}
        data-mac-href={`${baseUrl}/SoloMD_${VERSION}_universal.dmg`}
        data-win-href={`${baseUrl}/SoloMD_${VERSION}_x64_en-US.msi`}
        data-win-arm-href={`${baseUrl}/SoloMD_${VERSION}_arm64_en-US.msi`}
        data-linux-href={`${baseUrl}/SoloMD_${VERSION}_amd64.AppImage`}
      >
        ⬇ {tr.hero.ctaPrimary}
      </a>
      <!-- Stars are how a free project gets found; the second button asks
           for one, with the live count (filled by Header's [data-stars]). -->
      <a
        href={GITHUB_URL}
        class="btn btn--secondary btn--lg hero__star"
        target="_blank"
        rel="noopener"
        data-star-cta="hero"
      >
        <svg class="hero__star-gh" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>{tr.hero.ctaStar}</span>
        <span class="hero__star-count" data-stars>{initialStars > 0 ? fmtStars(initialStars) : '⭐'}</span>
      </a>
    </div>
    <p class="hero__trust">
      {(lang === 'zh'
        ? ['开源 · MIT', '已签名 · 已公证', '无需账号', '无广告', '永久免费']
        : ['Open source · MIT', 'Signed & notarized', 'No account', 'No ads', 'Free forever']
      ).map((t, i) => (
        <span class="hero__trust-item">{i > 0 && <span class="hero__trust-dot">·</span>}{t}</span>
      ))}
    </p>
    <!-- 5.0: the product, straight under the call to action — light or
         dark to match the visitor's system. The screenshots keep the
         window's own transparent rounded corners, so the shadow is a
         drop-shadow that follows them. -->
    <div class="hero__demo">
      <picture>
        <source srcset="/v5/mac-dark.webp" media="(prefers-color-scheme: dark)" type="image/webp" />
        <img
          class="hero__demo-media"
          src="/v5/mac-light.webp"
          alt={tr.hero.demoAlt}
          width="2400"
          height="1474"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="hero__whatsnew-row">
      <a href={whatsNewHref} class="hero__whatsnew">{tr.hero.ctaWhatsNew}</a>
    </div>
    <div class="hero__install">
      <div class="hero__install-label">
        ⚡ {ONE_LINE_LABEL}
      </div>
      <div class="hero__install-tabs">
        <button class="hi-tab hi-tab--active" data-hi-tab="unix">macOS / Linux</button>
        <button class="hi-tab" data-hi-tab="win">Windows</button>
      </div>
      <div class="hi-panel hi-panel--active" data-hi-panel="unix">
        <code class="hi-code">curl -fsSL https://solomd.app/install.sh | bash</code>
        <button class="hi-copy" data-hi-copy="curl -fsSL https://solomd.app/install.sh | bash" title="Copy">📋</button>
      </div>
      <div class="hi-panel" data-hi-panel="win">
        <code class="hi-code">irm https://solomd.app/install.ps1 | iex</code>
        <button class="hi-copy" data-hi-copy="irm https://solomd.app/install.ps1 | iex" title="Copy">📋</button>
      </div>
    </div>
    <a href="#download" class="hero__all-platforms">{tr.hero.ctaAllPlatforms}</a>
    {lang === 'zh' && (
      <a
        href={`https://gitee.com/zhitong45/solomd/releases/tag/v${VERSION}`}
        class="hero__gitee"
        rel="noopener"
      >
        🪞 国内用户：从 Gitee 镜像下载（更快）→
      </a>
    )}
    <div class="hero__chips">
      {tr.hero.chips.map((c) => <span class="chip">{c}</span>)}
    </div>

  </div>
</section>

<!-- Post-download star prompt: the moment someone has just chosen SoloMD is
     the one moment asking for a star is reasonable. Shown once; "later"
     hides it for 30 days, starring hides it for good. -->
<aside class="star-nudge" id="star-nudge" hidden aria-live="polite">
  <button class="star-nudge__close" type="button" aria-label={tr.hero.starNudgeLater} data-star-later>×</button>
  <p class="star-nudge__title">{tr.hero.starNudgeTitle}</p>
  <p class="star-nudge__body">{tr.hero.starNudgeBody}</p>
  <div class="star-nudge__actions">
    <a class="btn btn--primary star-nudge__cta" href={GITHUB_URL} target="_blank" rel="noopener" data-star-go>
      {tr.hero.starNudgeCta} <span class="star-nudge__count" data-stars></span>
    </a>
    <button class="star-nudge__later" type="button" data-star-later>{tr.hero.starNudgeLater}</button>
  </div>
</aside>

<script is:inline>
  (function () {
    var KEY = 'solomd.starNudge';
    var LATER_MS = 30 * 24 * 3600 * 1000;
    var card = document.getElementById('star-nudge');
    if (!card) return;
    function read() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
    function write(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) { /* private mode */ } }
    function suppressed() {
      var v = read();
      if (!v) return false;
      if (v.state === 'starred') return true;
      return v.state === 'later' && Date.now() - v.at < LATER_MS;
    }
    var shown = false;
    function show() {
      if (shown || suppressed()) return;
      shown = true;
      setTimeout(function () { card.hidden = false; card.classList.add('star-nudge--in'); }, 700);
    }
    function hide(state) {
      write({ state: state, at: Date.now() });
      card.classList.remove('star-nudge--in');
      card.hidden = true;
    }
    // Any way of getting SoloMD counts: an installer, a store page, the
    // Gitee mirror, or copying the one-line install command.
    var DOWNLOAD = /\/releases\/download\/|apps\.apple\.com|play\.google\.com\/store|apps\.microsoft\.com|gitee\.com\/[^/]+\/solomd\/releases/;
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('[data-star-go]')) { hide('starred'); return; }
      if (t.closest('[data-star-later]')) { hide('later'); return; }
      if (t.closest('[data-star-cta]')) { write({ state: 'starred', at: Date.now() }); return; }
      var a = t.closest('a[href]');
      if ((a && DOWNLOAD.test(a.href)) || t.closest('.hi-copy')) show();
    }, true);
  })();
</script>

<script is:inline>
  // Fetch live stars + downloads from our own /api/stats endpoint.
  // Cloudflare Pages Functions proxies GitHub API server-side with a 5-min
  // edge cache, so clients are never rate-limited and numbers update every
  // ~5 minutes automatically (no redeploy needed).
  (function () {
    fetch('/api/stats')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (stats) {
        if (!stats) return;
        // Guard with > 0, NOT != null. The /api/stats fallback used to
        // serve {stars: 0, downloads: 0} on GitHub failure — that's
        // numerically valid but visually meaningless ("⭐ 0 · 0
        // downloads" makes the project look dead) and it would clobber
        // the build-time SSR value already on screen.
        // Bug seen 2026-04-28; same fix mirrored in functions/api/stats.ts.
        if (typeof stats.stars === 'number' && stats.stars > 0) {
          var el = document.getElementById('hero-stars');
          if (el) {
            el.textContent = stats.stars >= 1000
              ? '⭐ ' + (stats.stars / 1000).toFixed(1) + 'k'
              : '⭐ ' + stats.stars;
          }
        }
        if (typeof stats.downloads === 'number' && stats.downloads > 0) {
          // All channels: GitHub installers + App Store + Microsoft Store +
          // Google Play (src/lib/download-channels.ts). Wording and 万 grouping
          // come from the element, so this matches the build-time text.
          var el2 = document.getElementById('hero-dl-count');
          if (el2) {
            var word = el2.getAttribute('data-word') || 'downloads';
            var wan = el2.getAttribute('data-wan') || '';
            var n = stats.downloads;
            el2.textContent = wan && n >= 10000
              ? (n / 10000).toFixed(1) + wan + (wan === '만' ? ' ' : '') + word
              : n >= 1000 ? (n / 1000).toFixed(1) + 'k ' + word : n + ' ' + word;
          }
          var el3 = document.getElementById('dl-section-count');
          if (el3) el3.textContent = stats.downloads.toLocaleString() + '+';
        }
      })
      .catch(function () { /* fall back to the build-time numbers in HTML */ });
  })();

  // Detect the visitor's OS and rewrite the hero download button to point at
  // the right artifact directly. Falls back gracefully to the universal mac
  // dmg if detection fails or the user has scripting disabled.
  (function () {
    var btn = document.getElementById('hero-download');
    if (!btn) return;
    var ua = navigator.userAgent || '';
    var platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
    var os = 'mac';
    if (/Win/i.test(ua) || /Windows/i.test(platform)) os = 'win';
    else if (/Linux/i.test(ua) && !/Android/i.test(ua)) os = 'linux';
    else if (/Mac|iPhone|iPad/i.test(ua) || /Mac/i.test(platform)) os = 'mac';
    var href = btn.getAttribute('data-' + os + '-href');
    var text = btn.getAttribute('data-' + os + '-text');
    if (href) btn.setAttribute('href', href);
    if (text) btn.innerHTML = '⬇ ' + text;

    // Also switch the one-line install block to Windows if user is on Windows
    if (os === 'win') {
      var winTab = document.querySelector('.hi-tab[data-hi-tab="win"]');
      if (winTab) winTab.click();

      // Windows on Arm cannot be detected from the UA string: Edge and Chrome
      // both report "Windows NT 10.0; Win64; x64" there for compatibility, so
      // the sniff above hands an Arm machine the x64 build. The architecture
      // is only available through high-entropy client hints, which are async —
      // hence the upgrade-after-the-fact rather than folding it in above. The
      // x64 link is already in place and works (emulated) if this never
      // resolves, so there is nothing to wait for.
      var uaData = navigator.userAgentData;
      if (uaData && uaData.getHighEntropyValues) {
        uaData.getHighEntropyValues(['architecture']).then(function (h) {
          if (h && h.architecture === 'arm') {
            var armHref = btn.getAttribute('data-win-arm-href');
            if (armHref) btn.setAttribute('href', armHref);
          }
        }).catch(function () { /* keep the x64 link */ });
      }
    }
  })();

  // One-line install: tab switch + copy-to-clipboard
  (function () {
    var tabs = document.querySelectorAll('.hi-tab');
    var panels = document.querySelectorAll('.hi-panel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-hi-tab');
        tabs.forEach(function (t) { t.classList.remove('hi-tab--active'); });
        tab.classList.add('hi-tab--active');
        panels.forEach(function (p) {
          if (p.getAttribute('data-hi-panel') === target) {
            p.classList.add('hi-panel--active');
          } else {
            p.classList.remove('hi-panel--active');
          }
        });
      });
    });
    var copyBtns = document.querySelectorAll('.hi-copy');
    copyBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-hi-copy') || '';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btn.textContent;
            btn.classList.add('copied');
            btn.textContent = '✓';
            setTimeout(function () {
              btn.classList.remove('copied');
              btn.textContent = orig;
            }, 1500);
          });
        }
      });
    });
  })();
</script>

<style>
  /* The visual identity changed in v4.11.3. Put the story above the product
     pitch so returning visitors immediately understand the unfamiliar icon. */
  .brand-update-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-decoration: none;
    padding: 17px 24px;
    background:
      radial-gradient(circle at 30% 10%, rgba(255, 159, 64, 0.18), transparent 32%),
      #121110;
    color: #fff9ef;
    border-bottom: 1px solid rgba(255, 159, 64, 0.24);
    transition: background-color 0.16s;
  }
  .brand-update-banner:hover {
    background-color: #1b1916;
  }
  .brand-update-banner__mark {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    box-shadow: 0 8px 24px rgba(255, 159, 64, 0.22);
    flex: 0 0 auto;
  }
  .brand-update-banner__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .brand-update-banner__eyebrow {
    color: #ff9f40;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .brand-update-banner__title {
    color: #fff9ef;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
  }
  .brand-update-banner__cta {
    margin-left: 22px;
    color: #d7d1c5;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .brand-update-banner {
      justify-content: flex-start;
      gap: 12px;
      padding: 14px 16px;
    }
    .brand-update-banner__mark { width: 40px; height: 40px; }
    .brand-update-banner__title { font-size: 16px; }
    .brand-update-banner__cta { display: none; }
  }

  /* Keep Android tester recruitment visible while the temporary brand story
     occupies the primary announcement slot. */

  /* v4.7 release announcement — a calmer info bar under the orange Android
     banner. Calls out the Windows-only editor rebuild so visitors learn
     about it without having to open the What's-new page. */
  .release-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    text-decoration: none;
    padding: 10px 20px;
    background: color-mix(in srgb, var(--accent) 9%, var(--bg-elev));
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.4;
    transition: background 0.15s;
