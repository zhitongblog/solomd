#!/bin/bash
#
# solomd - CLI for SoloMD Markdown Editor
# https://github.com/zhitongblog/solomd
#
# Usage:
#   solomd open <title|path>     Open a markdown file in SoloMD
#   solomd new <title> [text]    Create a new markdown file and open it
#   solomd list [folder]         List markdown files in a folder
#   solomd search <query>        Search markdown files in CWD for a query
#   solomd cat <title|path>      Print a markdown file's content
#   solomd export <file> -f FMT  Export to html / md / txt / docx (source checkout)
#   solomd agent <prompt>        Run an LLM CLI against the vault via MCP
#   solomd mcp <sub>             Manage the MCP entry in your AI clients
#   solomd help                  Show this help
#   solomd --version             Print the SoloMD version
#
# Every subcommand accepts -h / --help.
#
# Notes:
#   - Default notes directory: $SOLOMD_NOTES (or ~/Documents/SoloMD if unset)
#   - "title" arguments resolve to <notes-dir>/<title>.md if no extension is
#     given. Pass an explicit path to bypass this.

set -e

# ---- Version -------------------------------------------------------------
# Bumped with the app (see scripts/release.sh). A copy run from a source
# checkout reads the live version from tauri.conf.json instead, so the two
# can't drift there.
SOLOMD_VERSION="5.0.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

solomd_version() {
    local conf="$SCRIPT_DIR/../app/src-tauri/tauri.conf.json" v=""
    if [[ -f "$conf" ]]; then
        v="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$conf" | head -1)"
    fi
    echo "${v:-$SOLOMD_VERSION}"
}

# ---- Colors --------------------------------------------------------------
# Only when stdout is a terminal, and never with NO_COLOR set
# (https://no-color.org) — escapes in a pipe or a file are just noise.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    YELLOW='\033[0;33m'
    DIM='\033[2m'
    NC='\033[0m'
else
    GREEN='' BLUE='' YELLOW='' DIM='' NC=''
fi

# `-h` / `--help` anywhere in a subcommand's arguments means "show usage":
# it must never be taken as a title, a folder or a prompt (`new --help`
# used to create --help.md and open it).
wants_help() {
    local a
    for a in "$@"; do
        [[ "$a" == "-h" || "$a" == "--help" ]] && return 0
    done
    return 1
}

# ---- Notes dir resolution ------------------------------------------------
NOTES_DIR="${SOLOMD_NOTES:-$HOME/Documents/SoloMD}"

ensure_notes_dir() {
    if [[ ! -d "$NOTES_DIR" ]]; then
        mkdir -p "$NOTES_DIR"
    fi
}

# ---- App binary detection ------------------------------------------------
detect_solomd_bin() {
    if [[ "$(uname)" == "Darwin" ]]; then
        local mac_paths=(
            "/Applications/SoloMD.app/Contents/MacOS/SoloMD"
            "$HOME/Applications/SoloMD.app/Contents/MacOS/SoloMD"
        )
        for p in "${mac_paths[@]}"; do
            [[ -x "$p" ]] && echo "$p" && return 0
        done
    elif [[ "$(uname)" == "Linux" ]]; then
        for cmd in solomd SoloMD; do
            if command -v "$cmd" >/dev/null 2>&1; then
                command -v "$cmd"
                return 0
            fi
        done
        local linux_paths=(
            "/usr/bin/solomd"
            "/usr/local/bin/solomd"
            "/opt/SoloMD/solomd"
        )
        for p in "${linux_paths[@]}"; do
            [[ -x "$p" ]] && echo "$p" && return 0
        done
    fi
    return 1
}

# ---- Path resolution -----------------------------------------------------
# Resolve a title or path to a filesystem path. Rules:
#   1. If contains '/' or has .md/.markdown/.txt extension, use as-is
#      (relative to CWD if not absolute).
#   2. Otherwise, treat as title and look in $NOTES_DIR/<title>.md
resolve_path() {
    local input="$1"
    [[ -z "$input" ]] && return 1
    if [[ "$input" == /* ]]; then
        echo "$input"
        return 0
    fi
    if [[ "$input" == *.md || "$input" == *.markdown || "$input" == *.txt ]]; then
        echo "$PWD/$input"
        return 0
    fi
    if [[ "$input" == */* ]]; then
        echo "$PWD/$input"
        return 0
    fi
    echo "$NOTES_DIR/$input.md"
}

# ---- Commands ------------------------------------------------------------
cmd_help() {
    printf "${GREEN}solomd${NC} — CLI for SoloMD Markdown Editor\n"
    printf "         %s\n\n" "https://github.com/zhitongblog/solomd"
    printf "${BLUE}USAGE${NC}\n"
    printf "  solomd <command> [args]\n\n"
    printf "${BLUE}COMMANDS${NC}\n"
    printf "  ${GREEN}%-22s${NC} %s\n" "open <title|path>" "Open file in SoloMD"
    printf "  ${GREEN}%-22s${NC} %s\n" "new <title> [text]" "Create new note + open"
    printf "  ${GREEN}%-22s${NC} %s\n" "list [folder]" "List markdown files"
    printf "  ${GREEN}%-22s${NC} %s\n" "search <query>" "Search markdown for text"
    printf "  ${GREEN}%-22s${NC} %s\n" "cat <title|path>" "Print file content"
    printf "  ${GREEN}%-22s${NC} %s\n" "export <file> -f FMT" "Export to html / md / txt / docx (needs a source checkout)"
    printf "  ${GREEN}%-22s${NC} %s\n" "agent <prompt…>" "Run an LLM agent against the vault via MCP"
    printf "  ${GREEN}%-22s${NC} %s\n" "mcp <sub>" "Manage MCP integration (mcp help for subcommands)"
    printf "  ${GREEN}%-22s${NC} %s\n" "mcp-config" "Print the MCP config snippet (back-compat alias)"
    printf "  ${GREEN}%-22s${NC} %s\n" "help" "Show this help"
    printf "  ${GREEN}%-22s${NC} %s\n" "--version" "Print the SoloMD version"
    printf "\n  Every command takes ${GREEN}-h${NC} / ${GREEN}--help${NC} for its own usage.\n"
    printf "\n${BLUE}NOTES DIR${NC}\n"
    printf "  ${DIM}%s${NC}\n" "$NOTES_DIR"
    printf "  ${DIM}override with SOLOMD_NOTES env var${NC}\n"
}

usage_open() {
    echo "Usage: solomd open <title|path>"
    echo "  Open a note in SoloMD. A bare title resolves to <notes-dir>/<title>.md."
}

cmd_open() {
    wants_help "$@" && { usage_open; exit 0; }
    local target="$1"
    [[ -z "$target" ]] && { usage_open >&2; exit 1; }
    local path
    path="$(resolve_path "$target")"
    if [[ ! -f "$path" ]]; then
        printf "${YELLOW}File not found:${NC} %s\n" "$path" >&2
        exit 1
    fi
    local bin
    if bin="$(detect_solomd_bin)"; then
        "$bin" "$path" >/dev/null 2>&1 &
        disown 2>/dev/null || true
        printf "Opening ${GREEN}%s${NC}\n" "$path"
    elif [[ "$(uname)" == "Darwin" ]]; then
        open -a SoloMD "$path"
    else
        printf "${YELLOW}SoloMD not found.${NC} Install from https://solomd.app\n" >&2
        exit 1
    fi
}

usage_new() {
    echo "Usage: solomd new <title> [text]"
    echo "  Create <notes-dir>/<title>.md with a heading (and optional body), then open it."
}

cmd_new() {
    wants_help "$@" && { usage_new; exit 0; }
    local title="$1"; shift || true
    local body="$*"
    [[ -z "$title" ]] && { usage_new >&2; exit 1; }
    ensure_notes_dir
    local path
    path="$(resolve_path "$title")"
    if [[ -f "$path" ]]; then
        printf "${YELLOW}File already exists:${NC} %s\n" "$path" >&2
        exit 1
    fi
    {
        printf "# %s\n\n" "$title"
        [[ -n "$body" ]] && printf "%s\n" "$body"
    } > "$path"
    printf "Created ${GREEN}%s${NC}\n" "$path"
    cmd_open "$path"
}

usage_list() {
    echo "Usage: solomd list [folder]"
    echo "  List every markdown file under the folder (default: notes dir), at any depth."
    echo "  Hidden folders and node_modules are skipped."
}

cmd_list() {
    wants_help "$@" && { usage_list; exit 0; }
    local folder="${1:-$NOTES_DIR}"
    [[ "$folder" != "/" ]] && folder="${folder%/}"
    if [[ ! -d "$folder" ]]; then
        printf "${YELLOW}Not a folder:${NC} %s\n" "$folder" >&2
        exit 1
    fi
    # Any depth, like the app's file tree and MCP list_notes. -mindepth 1
    # keeps the prune test off the root itself, so `solomd list .` works.
    find "$folder" -mindepth 1 \( -name ".*" -o -name node_modules \) -prune -o \
            -type f \( -name "*.md" -o -name "*.markdown" \) -print 2>/dev/null \
        | sort \
        | while IFS= read -r f; do
            local rel="${f#$folder/}"
            printf "  ${GREEN}%s${NC}\n" "$rel"
        done
}

usage_search() {
    echo "Usage: solomd search <query>"
    echo "  Case-insensitive search of the notes dir (rg if installed, else grep)."
}

cmd_search() {
    wants_help "$@" && { usage_search; exit 0; }
    local query="$*"
    [[ -z "$query" ]] && { usage_search >&2; exit 1; }
    local folder="$NOTES_DIR"
    [[ ! -d "$folder" ]] && folder="$PWD"
    if command -v rg >/dev/null 2>&1; then
        rg --color=auto -i -t md "$query" "$folder" 2>/dev/null || {
            printf "${DIM}No matches for: %s${NC}\n" "$query"
        }
    else
        grep -ri --include="*.md" --include="*.markdown" -n "$query" "$folder" 2>/dev/null || {
            printf "${DIM}No matches for: %s${NC}\n" "$query"
        }
    fi
}

usage_cat() {
    echo "Usage: solomd cat <title|path>"
    echo "  Print a note to stdout."
}

cmd_cat() {
    wants_help "$@" && { usage_cat; exit 0; }
    local target="$1"
    [[ -z "$target" ]] && { usage_cat >&2; exit 1; }
    local path
    path="$(resolve_path "$target")"
    if [[ ! -f "$path" ]]; then
        printf "${YELLOW}File not found:${NC} %s\n" "$path" >&2
        exit 1
    fi
    cat "$path"
}

# `solomd export <file> [--format html|md|txt|docx] [--output <path>]`
# Convert a markdown file to another format using the same engine the GUI
# uses. Backs onto app/scripts/solomd-export.mjs (Node, no GUI required).
#
# That script and its node_modules only exist in a source checkout: the
# app bundle doesn't ship them and install-cli.sh only downloads this file.
# So an installed CLI says so plainly instead of pointing at a path that
# was never going to exist. SOLOMD_EXPORT_SCRIPT points it at a checkout.
usage_export() {
    echo "Usage: solomd export <title|path> [--format html|md|txt|docx] [--output <path>] [--number-headings]"
    echo "  Export with the same engine as the app. Default format html, written next to the note."
    echo "  Needs Node.js 18+ and a SoloMD source checkout with \`pnpm install\` run in app/:"
    echo "  run scripts/solomd from that checkout, or set SOLOMD_EXPORT_SCRIPT=<checkout>/app/scripts/solomd-export.mjs."
}

cmd_export() {
    wants_help "$@" && { usage_export; exit 0; }
    local target="$1"; shift || true
    [[ -z "$target" ]] && { usage_export >&2; exit 1; }
    local path
    path="$(resolve_path "$target")"
    if [[ ! -f "$path" ]]; then
        printf "${YELLOW}File not found:${NC} %s\n" "$path" >&2
        exit 1
    fi
    # Locate the script + the app dir (it must run with cwd = app/ so node
    # can resolve docx + markdown-it from app/node_modules without hassle).
    local script="${SOLOMD_EXPORT_SCRIPT:-$SCRIPT_DIR/../app/scripts/solomd-export.mjs}"
    if [[ ! -f "$script" ]]; then
        printf "${YELLOW}solomd export needs a SoloMD source checkout.${NC}\n" >&2
        printf "  It runs app/scripts/solomd-export.mjs with Node.js and the app's node_modules,\n" >&2
        printf "  which the installed app and install-cli.sh don't include. Either:\n" >&2
        printf "    git clone https://github.com/zhitongblog/solomd && cd solomd/app && pnpm install\n" >&2
        printf "    then run solomd/scripts/solomd export …\n" >&2
        printf "  or point this CLI at an existing checkout:\n" >&2
        printf "    export SOLOMD_EXPORT_SCRIPT=/path/to/solomd/app/scripts/solomd-export.mjs\n" >&2
        printf "  ${DIM}(In the app itself: File → Export.)${NC}\n" >&2
        exit 1
    fi
    local app_dir
    app_dir="$(cd "$(dirname "$script")/.." && pwd)"
    if ! command -v node >/dev/null 2>&1; then
        printf "${YELLOW}Node.js required for solomd export.${NC} Install Node 18+ (https://nodejs.org)\n" >&2
        exit 1
    fi
    if [[ ! -d "$app_dir/node_modules/docx" ]]; then
        printf "${YELLOW}app/node_modules missing. Run \`pnpm install\` in %s first.${NC}\n" "$app_dir" >&2
        exit 1
    fi
    (cd "$app_dir" && node "$script" "$path" "$@")
}

# ---- v3.1 agent endpoint -------------------------------------------------
# Detect the bundled solomd-mcp binary alongside the desktop app, falling
# back to anything on PATH. We don't ship a separate sidecar yet — the
# desktop app embeds it via tauri externalBin, so the lookup mirrors
# detect_solomd_bin().
detect_mcp_bin() {
    if [[ "$(uname)" == "Darwin" ]]; then
        # Tauri's externalBin lands next to the main binary in
        # Contents/MacOS/. Resources/ is where older builds and docs said
        # it was; kept as a fallback.
        local mac_paths=(
            "/Applications/SoloMD.app/Contents/MacOS/solomd-mcp"
            "$HOME/Applications/SoloMD.app/Contents/MacOS/solomd-mcp"
            "/Applications/SoloMD.app/Contents/Resources/solomd-mcp"
            "$HOME/Applications/SoloMD.app/Contents/Resources/solomd-mcp"
        )
        for p in "${mac_paths[@]}"; do
            [[ -x "$p" ]] && echo "$p" && return 0
        done
    elif [[ "$(uname)" == "Linux" ]]; then
        local linux_paths=(
            "/usr/lib/solomd/solomd-mcp"
            "/usr/local/lib/solomd/solomd-mcp"
            "/opt/SoloMD/solomd-mcp"
        )
        for p in "${linux_paths[@]}"; do
            [[ -x "$p" ]] && echo "$p" && return 0
        done
    fi
    if command -v solomd-mcp >/dev/null 2>&1; then
        command -v solomd-mcp
        return 0
    fi
    return 1
}

usage_mcp_config() {
    echo "Usage: solomd mcp-config"
    echo "  Print a Claude Desktop style mcpServers snippet for the bundled solomd-mcp."
    echo "  The workspace is \$SOLOMD_NOTES (default ~/Documents/SoloMD)."
}

cmd_mcp_config() {
    wants_help "$@" && { usage_mcp_config; exit 0; }
    local mcp_bin
    if ! mcp_bin="$(detect_mcp_bin)"; then
        printf "${YELLOW}solomd-mcp not found.${NC} Install SoloMD or run install-mcp.sh.\n" >&2
        printf "${DIM}https://github.com/zhitongblog/solomd/blob/main/scripts/install-mcp.sh${NC}\n" >&2
        exit 1
    fi
    local workspace="${SOLOMD_NOTES:-$HOME/Documents/SoloMD}"
    cat <<EOF
{
  "mcpServers": {
    "solomd": {
      "command": "$mcp_bin",
      "args": ["--workspace", "$workspace"]
    }
  }
}
EOF
}

# ---- v4.4.5 — auto-inject solomd-mcp into 6 AI clients' configs ---------
# Mirror of Rust `integrations.rs` so CLI users (no GUI running) can do the
# same flow as Settings → Integrations → "Hook SoloMD into your AI clients".
# Requires `jq` for safe JSON merging — refuse to write if it's missing.

ai_client_path() {
    local client="$1"
    local os
    os="$(uname -s)"
    case "$client" in
        claude-desktop)
            case "$os" in
                Darwin) echo "$HOME/Library/Application Support/Claude/claude_desktop_config.json" ;;
                Linux)  echo "$HOME/.config/Claude/claude_desktop_config.json" ;;
                *)      echo "${APPDATA:-$HOME/AppData/Roaming}/Claude/claude_desktop_config.json" ;;
            esac ;;
        # User-scope MCP servers live in ~/.claude.json — the single
        # dotfile. ~/.claude/mcp.json is never read by Claude Code.
        claude-code) echo "$HOME/.claude.json" ;;
        cursor)      echo "$HOME/.cursor/mcp.json" ;;
        cline)
            case "$os" in
                Darwin) echo "$HOME/Library/Application Support/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json" ;;
                Linux)  echo "$HOME/.config/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json" ;;
                *)      echo "${APPDATA:-$HOME/AppData/Roaming}/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json" ;;
            esac ;;
        continue)    echo "$HOME/.continue/config.json" ;;
        zed)
            case "$os" in
                Darwin|Linux) echo "$HOME/.config/zed/settings.json" ;;
                *)            echo "${APPDATA:-$HOME/AppData/Roaming}/Zed/settings.json" ;;
            esac ;;
        *) return 1 ;;
    esac
}

# "Is this client installed?" probe. Usually the config file's directory,
# but Claude Code's config sits directly in $HOME (which always exists), so
# probe ~/.claude instead.
ai_client_probe_dir() {
    case "$1" in
        claude-code) echo "$HOME/.claude" ;;
        *)           dirname "$(ai_client_path "$1")" ;;
    esac
}

ai_clients=(claude-desktop claude-code cursor cline continue zed)
ai_client_label() {
    case "$1" in
        claude-desktop) echo "Claude Desktop" ;;
        claude-code)    echo "Claude Code" ;;
        cursor)         echo "Cursor" ;;
        cline)          echo "Cline (VS Code)" ;;
        continue)       echo "Continue.dev" ;;
        zed)            echo "Zed" ;;
    esac
}

# Does this client's config already declare a solomd server? Checks the key
# the client actually uses when jq is available — a bare substring match
# false-positives on ~/.claude.json, which also stores per-project history
# (any folder with "solomd" in its path would look "configured").
client_has_solomd() {
    local client="$1" path="$2" filter
    if ! command -v jq >/dev/null 2>&1; then
        grep -q '"solomd"\|"name": "solomd"' "$path" 2>/dev/null
        return
    fi
    case "$client" in
        continue) filter='(.mcp // []) | map(select(.name == "solomd")) | length > 0' ;;
        zed)      filter='(.context_servers // {}) | has("solomd")' ;;
        *)        filter='(.mcpServers // {}) | has("solomd")' ;;
    esac
    [[ "$(jq -r "$filter" "$path" 2>/dev/null)" == "true" ]]
}

cmd_mcp_list() {
    printf "${BLUE}AI clients on this machine${NC}\n\n"
    printf "  %-18s %-4s %-13s %s\n" "CLIENT" "DIR" "HAS SOLOMD" "PATH"
    printf "  %-18s %-4s %-13s %s\n" "------" "---" "----------" "----"
    local client path dir_color dir_text entry_color entry_text
    for client in "${ai_clients[@]}"; do
        path="$(ai_client_path "$client")"
        if [[ -d "$(ai_client_probe_dir "$client")" ]]; then
            dir_color="$GREEN"; dir_text="yes"
        else
            dir_color="$DIM"; dir_text="no"
        fi
        if [[ -f "$path" ]] && client_has_solomd "$client" "$path"; then
            entry_color="$GREEN"; entry_text="configured"
        else
            entry_color="$DIM"; entry_text="—"
        fi
        # Put colors in the format string so printf interprets the escapes.
        # %b would also work for arg values, but format-string is cleaner.
        printf "  %-18s ${dir_color}%-4s${NC} ${entry_color}%-13s${NC} ${DIM}%s${NC}\n" \
            "$(ai_client_label "$client")" "$dir_text" "$entry_text" "$path"
    done
}

# jq is the only safe way to do a "preserve user's hand-edits + insert
# solomd" merge across this many client schemas. Bail out loudly when it
# isn't available so the user doesn't end up with a corrupted config.
require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        printf "${YELLOW}solomd mcp install needs jq.${NC} Install it:\n" >&2
        printf "  ${DIM}macOS:${NC}   brew install jq\n" >&2
        printf "  ${DIM}Debian:${NC}  sudo apt-get install jq\n" >&2
        printf "  ${DIM}Fedora:${NC}  sudo dnf install jq\n" >&2
        exit 1
    fi
}

inject_one_client() {
    local client="$1" mcp_bin="$2" workspace="$3" allow_write="$4"
    local path
    path="$(ai_client_path "$client")"

    # Claude Code: let its own CLI write ~/.claude.json when it's on PATH.
    # That file also holds session state a running Claude Code rewrites, so
    # a jq round-trip here can lose whatever it flushes meanwhile.
    if [[ "$client" == "claude-code" ]] && command -v claude >/dev/null 2>&1; then
        local cli_args=("--workspace" "$workspace")
        [[ "$allow_write" == "true" ]] && cli_args+=("--allow-write")
        claude mcp remove solomd -s user >/dev/null 2>&1 || true
        if claude mcp add --scope user solomd -- "$mcp_bin" "${cli_args[@]}" >/dev/null; then
            printf "  ${GREEN}✓${NC} %s — %s ${DIM}(via claude mcp add)${NC}\n" \
                "$(ai_client_label "$client")" "$path"
            return
        fi
        printf "  ${YELLOW}!${NC} claude mcp add failed — patching %s directly\n" "$path"
    fi

    mkdir -p "$(dirname "$path")"
    # Backup any existing file before touching it.
    if [[ -f "$path" ]]; then
        cp "$path" "$path.bak.$(date +%s)"
    fi
    # Build the args array — JSON-safe via jq's --args.
    local args=("--workspace" "$workspace")
    [[ "$allow_write" == "true" ]] && args+=("--allow-write")
    local existing="{}"
    [[ -s "$path" ]] && existing="$(cat "$path")"
    local merged
    case "$client" in
        claude-desktop|claude-code|cursor|cline)
            local entry
            if [[ "$client" == "cline" ]]; then
                entry="$(jq -n \
                    --arg cmd "$mcp_bin" \
                    --args \
                    '{command:$cmd, args:$ARGS.positional, disabled:false, autoApprove:["list_notes","read_note","search","get_outline","get_backlinks","list_tags","autogit_log","autogit_diff","sync_status","share_url","read_agent_trace"]}' \
                    -- "${args[@]}")"
            else
                entry="$(jq -n --arg cmd "$mcp_bin" --args '{command:$cmd, args:$ARGS.positional}' -- "${args[@]}")"
            fi
            merged="$(echo "$existing" | jq --argjson entry "$entry" '. + {mcpServers: ((.mcpServers // {}) + {solomd: $entry})}')"
            ;;
        continue)
            local entry
            entry="$(jq -n --arg cmd "$mcp_bin" --args '{name:"solomd", command:$cmd, args:$ARGS.positional}' -- "${args[@]}")"
            merged="$(echo "$existing" | jq --argjson entry "$entry" '. + {mcp: ((.mcp // []) | map(select(.name != "solomd")) + [$entry])}')"
            ;;
        zed)
            local entry
            entry="$(jq -n --arg cmd "$mcp_bin" --args '{command:{path:$cmd, args:$ARGS.positional}, settings:{}}' -- "${args[@]}")"
            merged="$(echo "$existing" | jq --argjson entry "$entry" '. + {context_servers: ((.context_servers // {}) + {solomd: $entry})}')"
            ;;
    esac
    printf "%s\n" "$merged" > "$path"
    printf "  ${GREEN}✓${NC} %s — %s\n" "$(ai_client_label "$client")" "$path"
}

remove_one_client() {
    local client="$1" path
    path="$(ai_client_path "$client")"
    if [[ "$client" == "claude-code" ]] && command -v claude >/dev/null 2>&1; then
        if claude mcp remove solomd -s user >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} %s — solomd entry removed ${DIM}(via claude mcp remove)${NC}\n" \
                "$(ai_client_label "$client")"
            return
        fi
    fi
    if [[ ! -f "$path" ]]; then
        printf "  ${DIM}–${NC} %s — no config to clean\n" "$(ai_client_label "$client")"
        return
    fi
    cp "$path" "$path.bak.$(date +%s)"
    local cleaned
    case "$client" in
        claude-desktop|claude-code|cursor|cline)
            cleaned="$(jq 'if .mcpServers then .mcpServers |= del(.solomd) else . end' "$path")" ;;
        continue)
            cleaned="$(jq 'if .mcp then .mcp |= map(select(.name != "solomd")) else . end' "$path")" ;;
        zed)
            cleaned="$(jq 'if .context_servers then .context_servers |= del(.solomd) else . end' "$path")" ;;
    esac
    printf "%s\n" "$cleaned" > "$path"
    printf "  ${GREEN}✓${NC} %s — solomd entry removed\n" "$(ai_client_label "$client")"
}

cmd_mcp_install() {
    require_jq
    local mcp_bin
    if ! mcp_bin="$(detect_mcp_bin)"; then
        printf "${YELLOW}solomd-mcp not found.${NC} Install SoloMD first.\n" >&2
        exit 1
    fi
    local workspace="${SOLOMD_NOTES:-$HOME/Documents/SoloMD}"
    local allow_write="false"
    local targets=()
    # Parse flags + positional client list.
    while (( $# )); do
        case "$1" in
            --workspace) workspace="$2"; shift 2 ;;
            --workspace=*) workspace="${1#*=}"; shift ;;
            --allow-write) allow_write="true"; shift ;;
            --all) targets=("${ai_clients[@]}"); shift ;;
            -h|--help)
                printf "Usage: solomd mcp install [CLIENT…] [--workspace PATH] [--allow-write] [--all]\n"
                printf "  CLIENT: %s\n" "${ai_clients[*]}"
                exit 0 ;;
            *) targets+=("$1"); shift ;;
        esac
    done
    if [[ ${#targets[@]} -eq 0 ]]; then
        # Default: install into every client whose config DIR already exists.
        for c in "${ai_clients[@]}"; do
            [[ -d "$(ai_client_probe_dir "$c")" ]] && targets+=("$c")
        done
    fi
    if [[ ${#targets[@]} -eq 0 ]]; then
        printf "${YELLOW}No AI client detected on this machine.${NC} Pass a client name or --all to override.\n"
        exit 1
    fi
    printf "${BLUE}Installing SoloMD MCP server for ${#targets[@]} client(s)${NC}\n"
    printf "  ${DIM}binary:    %s${NC}\n" "$mcp_bin"
    printf "  ${DIM}workspace: %s${NC}\n" "$workspace"
    printf "  ${DIM}--allow-write: %s${NC}\n\n" "$allow_write"
    for c in "${targets[@]}"; do
        inject_one_client "$c" "$mcp_bin" "$workspace" "$allow_write"
    done
    printf "\n${YELLOW}Restart the AI client(s) for the new MCP server to load.${NC}\n"
}

cmd_mcp_uninstall() {
    require_jq
    local targets=()
    while (( $# )); do
        case "$1" in
            --all) targets=("${ai_clients[@]}"); shift ;;
            -h|--help)
                printf "Usage: solomd mcp uninstall [CLIENT…] [--all]\n"
                printf "  CLIENT: %s\n" "${ai_clients[*]}"
                exit 0 ;;
            *) targets+=("$1"); shift ;;
        esac
    done
    if [[ ${#targets[@]} -eq 0 ]]; then
        # Default: clean every config that already has a solomd entry.
        for c in "${ai_clients[@]}"; do
            local p
            p="$(ai_client_path "$c")"
            [[ -f "$p" ]] && client_has_solomd "$c" "$p" && targets+=("$c")
        done
    fi
    if [[ ${#targets[@]} -eq 0 ]]; then
        printf "${DIM}Nothing to uninstall — no client has a solomd entry.${NC}\n"
        exit 0
    fi
    printf "${BLUE}Removing SoloMD MCP entry from ${#targets[@]} client(s)${NC}\n"
    for c in "${targets[@]}"; do
        remove_one_client "$c"
    done
}

cmd_mcp() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list|ls)          cmd_mcp_list "$@" ;;
        install|add)      cmd_mcp_install "$@" ;;
        uninstall|rm)     cmd_mcp_uninstall "$@" ;;
        config)           cmd_mcp_config "$@" ;;   # back-compat with old `solomd mcp-config`
        -h|--help|help)
            printf "${BLUE}solomd mcp${NC} — manage SoloMD's MCP server entry across your AI clients\n\n"
            printf "${BLUE}USAGE${NC}\n  solomd mcp <subcommand> [args]\n\n"
            printf "${BLUE}SUBCOMMANDS${NC}\n"
            printf "  ${GREEN}%-20s${NC} %s\n" "list" "Show which AI clients are present + status"
            printf "  ${GREEN}%-20s${NC} %s\n" "install [CLIENT…]" "Inject solomd into the named clients"
            printf "  ${GREEN}%-20s${NC} %s\n" "uninstall [CLIENT…]" "Remove solomd from the named clients"
            printf "  ${GREEN}%-20s${NC} %s\n" "config" "Print generic Claude Desktop snippet (back-compat)"
            printf "\n${BLUE}CLIENTS${NC}\n  ${DIM}%s${NC}\n" "${ai_clients[*]}"
            ;;
        *) printf "${YELLOW}Unknown mcp subcommand:${NC} %s\n" "$sub"; exit 1 ;;
    esac
}

# `solomd agent <prompt>` — hand the prompt off to whichever LLM CLI is on
# PATH (claude / codex / aider), with solomd-mcp pre-wired. We deliberately
# do not implement an LLM loop ourselves: the user already has Claude Code,
# Codex CLI, or aider installed and configured with their BYOK keys. Our
# job is to put a SoloMD MCP server in front of that CLI so it can read +
# edit the vault, then pass through.
usage_agent() {
    echo "Usage: solomd agent <prompt>"
    echo "  Start claude (or codex) with solomd-mcp wired to the notes dir, --allow-write on."
    echo "  e.g. solomd agent 'rewrite this week of dailies into a weekly review'"
}

cmd_agent() {
    wants_help "$@" && { usage_agent; exit 0; }
    local prompt="$*"
    [[ -z "$prompt" ]] && { usage_agent >&2; exit 1; }

    local mcp_bin
    if ! mcp_bin="$(detect_mcp_bin)"; then
        printf "${YELLOW}solomd-mcp not found.${NC}\n" >&2
        printf "  SoloMD bundles solomd-mcp inside the app (Mac/Linux). Make sure SoloMD is installed,\n" >&2
        printf "  or run scripts/install-mcp.sh from this repo to drop it on PATH.\n" >&2
        exit 1
    fi
    local workspace="${SOLOMD_NOTES:-$HOME/Documents/SoloMD}"

    # Generate a one-shot MCP config in TMPDIR so the LLM CLI can pick it
    # up without us touching the user's persistent config.
    local cfg_dir
    cfg_dir="$(mktemp -d -t solomd-agent.XXXXXX)"
    # The config grants --allow-write, so it must not outlive the session.
    # The LLM CLI runs as a child (no exec) so this trap actually fires.
    trap "rm -rf '$cfg_dir'" EXIT
    local cfg="$cfg_dir/mcp.json"
    cat > "$cfg" <<EOF
{
  "mcpServers": {
    "solomd": {
      "command": "$mcp_bin",
      "args": ["--workspace", "$workspace", "--allow-write"]
    }
  }
}
EOF

    printf "${DIM}vault:    %s${NC}\n" "$workspace"
    printf "${DIM}mcp:      %s${NC}\n" "$mcp_bin"

    if command -v claude >/dev/null 2>&1; then
        printf "${BLUE}→ claude${NC} (Claude Code CLI)\n\n"
        # `claude "query"` starts an interactive session seeded with the
        # query. `--mcp-config` registers the SoloMD MCP for that session.
        # We don't pass `-p` (non-interactive one-shot) by default — agent
        # work usually needs follow-up turns.
        claude --mcp-config "$cfg" -- "$prompt"
    elif command -v codex >/dev/null 2>&1; then
        printf "${BLUE}→ codex${NC} (Codex CLI)\n\n"
        # Codex CLI registers MCP servers via ~/.codex/config.toml, not a
        # CLI flag. Print the right snippet and run codex with the prompt.
        printf "${DIM}Add this to ~/.codex/config.toml if not already present:${NC}\n"
        printf "  [mcp_servers.solomd]\n"
        printf "  command = \"%s\"\n" "$mcp_bin"
        printf "  args = [\"--workspace\", \"%s\", \"--allow-write\"]\n\n" "$workspace"
        codex "$prompt"
    elif command -v aider >/dev/null 2>&1; then
        printf "${BLUE}→ aider${NC} (no native MCP — printing recipe instead)\n\n"
        printf "  The aider CLI doesn't speak MCP. Either:\n"
        printf "  1. Install Claude Code: https://docs.claude.com/en/docs/claude-code\n"
        printf "  2. Or run: aider %s\n" "$workspace"
        printf "     (it will read+edit notes directly without the SoloMD MCP wrapper)\n"
        exit 0
    else
        printf "${YELLOW}No supported LLM CLI found on PATH.${NC}\n\n" >&2
        printf "  Install one of:\n" >&2
        printf "    Claude Code  — https://docs.claude.com/en/docs/claude-code\n" >&2
        printf "    Codex CLI    — https://github.com/openai/codex\n" >&2
        printf "  Then re-run: solomd agent '$prompt'\n\n" >&2
        printf "${DIM}MCP config that would be used:${NC}\n" >&2
        cat "$cfg" >&2
        exit 1
    fi
}

# ---- Dispatch ------------------------------------------------------------
case "${1:-help}" in
    open)       shift; cmd_open "$@" ;;
    new)        shift; cmd_new "$@" ;;
    list)       shift; cmd_list "$@" ;;
    search)     shift; cmd_search "$@" ;;
    cat)        shift; cmd_cat "$@" ;;
    export)     shift; cmd_export "$@" ;;
    agent)      shift; cmd_agent "$@" ;;
    mcp-config) shift; cmd_mcp_config "$@" ;;
    mcp)        shift; cmd_mcp "$@" ;;
    help|--help|-h) cmd_help ;;
    version|--version|-V) echo "solomd $(solomd_version)" ;;
    *) printf "${YELLOW}Unknown command:${NC} %s\n\n" "$1"; cmd_help; exit 1 ;;
esac
