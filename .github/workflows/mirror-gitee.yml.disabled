# Mirror the GitHub repo to Gitee on every push.
#
# Requires repo secrets:
#   GITEE_PRIVATE_KEY  — ed25519 private key registered on Gitee
#   GITEE_USERNAME     — Gitee username (e.g. zhitong45)
#
# Branches + tags both push. Force-mirror so Gitee tracks GitHub
# 1:1 (any out-of-band edits on Gitee are overwritten — that's the point).

name: Mirror to Gitee

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch: {}

concurrency:
  group: mirror-gitee
  cancel-in-progress: false

jobs:
  mirror:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout (full history, all refs)
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Add Gitee SSH key
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.GITEE_PRIVATE_KEY }}

      - name: Trust gitee.com host key
        # Pinned statically — `ssh-keyscan gitee.com` from Actions runners
        # times out intermittently (Gitee throttles the datacenter IPs) and
        # was the cause of ~16% of mirror runs dying before the push even
        # started. Key verified 2026-08-07 from two independent network
        # paths; fingerprint SHA256:+ULzij2u99B9eWYFTw1Q4ErYG/aepHLbu96PAUCoV88
        # matches Gitee's published ED25519 fingerprint. If Gitee ever
        # rotates it, this step needs the new key (push will fail closed
        # with a host-key mismatch, not silently trust).
        run: |
          mkdir -p ~/.ssh
          echo "gitee.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEKxHSJ7084RmkJ4YdEi5tngynE8aZe2uEoVVsB/OvYN" >> ~/.ssh/known_hosts

      - name: Push everything to Gitee
        env:
          GITEE_USER: ${{ secrets.GITEE_USERNAME }}
        run: |
          set -euo pipefail
          REMOTE="git@gitee.com:${GITEE_USER}/solomd.git"
          # Not `--mirror`: in an Actions checkout that also pushes
          # refs/remotes/origin/* ("deny updating a hidden ref" on Gitee).
          # Mirror GitHub's branches (origin/*) and tags explicitly;
          # `--prune` deletes Gitee refs that no longer exist on GitHub.
          git remote set-head origin -d
          # Gitee's SSH endpoint drops connections from Actions runners now
          # and then — retry a few times before declaring failure.
          for attempt in 1 2 3 4; do
            if git push --prune --force "$REMOTE" \
              "refs/remotes/origin/*:refs/heads/*" \
              "refs/tags/*:refs/tags/*"; then
              exit 0
            fi
            echo "push attempt ${attempt} failed; retrying in $((attempt * 10))s…"
            sleep $((attempt * 10))
          done
          echo "all push attempts failed" >&2
          exit 1
