name: Linux 24.04 test build (#170)

# One-off diagnostic build for issue #170 — EGL_BAD_PARAMETER on modern
# Intel GPUs.
#
# Our shipped Linux bundles are built on ubuntu-22.04, which means the
# AppImage carries GLib 2.72 / GTK 3 / WebKitGTK 4.1 from 2022 and then
# initializes EGL against the host's mesa (26.x on the affected machines).
# Verified by unpacking the v4.11.13 AppImage: it contains
# libgio-2.0.so.0.7200.4 (GLib 2.72) but no libEGL/libGL/mesa, and the
# reporter's log shows `undefined symbol: g_task_set_static_name`, which
# needs GLib >= 2.76.
#
# This builds the exact same bundles on ubuntu-24.04 (GLib 2.80,
# WebKitGTK 2.52) so affected users can test whether the build base is
# the whole story. Deliberately a SEPARATE workflow, uploading artifacts
# rather than touching a release, so the shipping pipeline is unchanged
# while we find out. Delete this file once #170 is resolved either way.
#
# Run: gh workflow run linux-2404-test.yml --ref <branch>

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: lts/*

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Setup Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: swatinem/rust-cache@v2
        with:
          workspaces: app/src-tauri -> target

      # Same dependency list as release.yml. libfuse2 is libfuse2t64 on
      # 24.04 (the t64 time_t transition renamed it).
      - name: Install Linux build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libwebkit2gtk-4.1-dev \
            libappindicator3-dev \
            librsvg2-dev \
            patchelf \
            libssl-dev \
            libdbus-1-dev \
            xdg-utils \
            file \
            fuse \
            libfuse2t64

      - name: Record toolchain versions
        run: |
          echo "--- versions this bundle will carry ---"
          dpkg -s libglib2.0-0t64 2>/dev/null | grep -E '^Version' || dpkg -s libglib2.0-0 | grep -E '^Version'
          dpkg -s libwebkit2gtk-4.1-0 | grep -E '^Version'
          dpkg -s libgtk-3-0t64 2>/dev/null | grep -E '^Version' || dpkg -s libgtk-3-0 | grep -E '^Version'
          ldd --version | head -1

      - name: Install frontend dependencies
        run: cd app && pnpm install --frozen-lockfile

      - name: Pre-build solomd-mcp sidecar
        shell: bash
        run: |
          set -euo pipefail
          TRIPLE="$(rustc -vV | sed -n 's/^host: //p')"
          echo "host triple: $TRIPLE"
          bash scripts/build-mcp-sidecar.sh "$TRIPLE"

      - name: Build bundles
        run: cd app && pnpm tauri build --bundles appimage,deb

      - name: Show what got bundled
        run: |
          echo "--- AppImage / deb produced ---"
          find app/src-tauri/target/release/bundle -name '*.AppImage' -o -name '*.deb' | xargs ls -la

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: solomd-linux-x64-ubuntu2404
          if-no-files-found: error
          path: |
            app/src-tauri/target/release/bundle/appimage/*.AppImage
            app/src-tauri/target/release/bundle/deb/*.deb
